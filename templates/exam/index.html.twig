{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Simulador de Examen de Certificación Senior | Senior DevLab{% endblock %}

{% block body %}
<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span class="user-badge" style="background: rgba(108, 124, 255, 0.15); border-color: rgba(108, 124, 255, 0.4); color: #8fa4ff;">
                {{ icons.icon('award', 13) }}
                <span>Práctica Intercalada</span>
            </span>
            <span class="user-badge" style="background: rgba(255, 255, 255, 0.05); border-color: var(--border-main); color: var(--text-muted);">
                Umbral de Aprobación: 75%
            </span>
        </div>
        <h1 class="page-title" style="display: flex; align-items: center; gap: 10px; font-size: 22px; margin-bottom: 6px;">
            {{ icons.icon('test-tube', 22) }}
            <span>Simulador de Certificaci&oacute;n T&eacute;cnica Senior</span>
        </h1>
        <p class="page-subtitle" style="color: var(--text-muted); font-size: 13px; margin: 0; max-width: 800px;">
            Evaluaci&oacute;n cruzada de conceptos entre diferentes m&oacute;dulos estudiados. Simula una entrevista t&eacute;cnica de nivel Staff / Principal donde el contexto salta entre arquitectura, testing, runtime y persistencia.
        </p>
    </div>

    <!-- Exam Meta Metrics -->
    {% if exam.questions|length > 0 %}
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <div class="review-meter">
            <span>{{ icons.icon('check-square', 13) }}</span>
            <span>Preguntas: <strong>{{ exam.questions|length }}</strong></span>
            <span style="color: var(--border-strong);">&bull;</span>
            <span>M&oacute;dulos: <strong>{{ exam.modules|length }}</strong></span>
            <span style="color: var(--border-strong);">&bull;</span>
            <span>Banco disponible: <strong>{{ exam.pool }}</strong></span>
        </div>
    </div>
    {% endif %}
</div>

{% if exam.questions|length == 0 %}
    <!-- Empty State: Not Enough Material Studied -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-main); border-radius: var(--radius-lg); padding: 48px 24px; text-align: center; max-width: 620px; margin: 40px auto;">
        <div style="display: inline-flex; padding: 16px; background: rgba(246, 169, 59, 0.12); border-radius: 50%; color: var(--accent-amber); margin-bottom: 16px;">
            {{ icons.icon('alert-triangle', 36) }}
        </div>
        <h2 style="font-size: 18px; font-weight: 700; color: var(--text-bright); margin-bottom: 8px;">
            Requieres lecciones estudiadas para generar un examen
        </h2>
        <p style="color: var(--text-muted); font-size: 13px; line-height: 1.6; margin: 0 0 24px 0;">
            El simulador de examen genera preguntas intercaladas basadas en las lecciones que ya has iniciado o completado. Comienza estudiando las primeras lecciones del roadmap para habilitar la simulaci&oacute;n.
        </p>
        <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
            <a href="{{ path('app_roadmap') }}" class="btn-vs">
                {{ icons.icon('map', 14) }}
                <span>Ir al Roadmap</span>
            </a>
            <a href="{{ path('app_paths') }}" class="btn-vs btn-vs-secondary">
                {{ icons.icon('git-branch', 14) }}
                <span>Explorar Rutas</span>
            </a>
        </div>
    </div>
{% else %}
    <!-- Exam Form -->
    <form action="{{ path('app_exam_submit') }}" method="POST" id="exam-form" style="max-width: 820px; margin: 0 auto;">
        <!-- Modules Tag Bar -->
        <div style="background: var(--bg-deep); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <span style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">M&oacute;dulos evaluados en esta ronda:</span>
                {% for m in exam.modules %}
                    <span class="user-badge" style="background: rgba(255, 255, 255, 0.04); border-color: var(--border-main); color: #9cdcfe; font-size: 11px;">
                        {{ m }}
                    </span>
                {% endfor %}
            </div>
            <div id="exam-timer" style="font-family: var(--font-mono); font-size: 12px; color: var(--accent-cyan); display: flex; align-items: center; gap: 6px;">
                {{ icons.icon('refresh-cw', 12) }}
                <span id="timer-display">00:00</span>
            </div>
        </div>

        <!-- Questions List -->
        {% for q in exam.questions %}
        <div class="exam-question" style="background: var(--bg-surface); border: 1px solid var(--border-main); border-radius: var(--radius-lg); padding: 20px 24px; margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span style="font-family: var(--font-mono); font-size: 11px; color: var(--accent-primary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
                    Pregunta 0{{ loop.index }} &bull; {{ q.module }}
                </span>
                <span style="font-size: 11px; color: var(--text-muted);">
                    {{ q.lesson_title }}
                </span>
            </div>

            <div class="exam-stem" style="font-size: 14px; font-weight: 600; color: var(--text-bright); line-height: 1.55; margin-bottom: 16px;">
                {{ q.question }}
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                {% for key, text in q.options %}
                <label class="option" style="display: flex; align-items: flex-start; gap: 12px; padding: 10px 14px; background: var(--bg-card); border: 1px solid var(--border-light); border-radius: var(--radius-md); cursor: pointer; transition: all 0.15s ease;">
                    <input type="radio" name="answers[{{ q.key }}]" value="{{ key }}" style="margin-top: 3px;" required>
                    <span class="option-key" style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); border: 1px solid var(--border-main); border-radius: 3px; padding: 1px 5px; flex-shrink: 0;">
                        {{ key|upper }}
                    </span>
                    <span style="font-size: 13px; color: var(--text-primary); line-height: 1.45;">
                        {{ text }}
                    </span>
                </label>
                {% endfor %}
            </div>
        </div>
        {% endfor %}

        <!-- Submit Panel -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-main); border-radius: var(--radius-md); padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin-top: 28px; margin-bottom: 40px;">
            <div>
                <div style="font-size: 13px; font-weight: 600; color: var(--text-bright);">¿Listo para calificar?</div>
                <div style="font-size: 11.5px; color: var(--text-muted);">El sistema calculará tu porcentaje global y tu índice de dominio por competencia.</div>
            </div>
            <button type="submit" class="btn-vs" style="font-size: 13px; padding: 10px 24px;">
                {{ icons.icon('check-circle', 14) }}
                <span>Entregar Examen y Ver Diagnóstico</span>
            </button>
        </div>
    </form>

    <script>
    (function() {
        // Stopwatch timer
        let seconds = 0;
        const timerDisplay = document.getElementById('timer-display');
        setInterval(function() {
            seconds++;
            const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
            const secs = String(seconds % 60).padStart(2, '0');
            if (timerDisplay) timerDisplay.textContent = mins + ':' + secs;
        }, 1000);
    })();
    </script>
{% endif %}
{% endblock %}
