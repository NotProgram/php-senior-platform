{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}{{ lesson.title }} | Senior DevLab{% endblock %}

{% block body %}
<!-- Lesson Header -->
<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span class="user-badge" style="background: rgba(79, 93, 149, 0.2); border-color: rgba(79, 93, 149, 0.4); color: #9bb0ff;">
                {{ icons.icon(module.icon ?? 'code', 14) }}
                <span>{{ module.title }}</span>
            </span>
            <span class="user-badge" style="background: rgba(255, 255, 255, 0.05); border-color: var(--border-main); color: var(--text-muted);">
                {{ lesson.minutes }} minutos &bull; Nivel {{ lesson.difficulty }}
            </span>
        </div>
        <h1 class="page-title">
            {{ icons.icon('file-code', 22) }}
            <span>{{ lesson.title }}</span>
        </h1>
    </div>

    <div>
        {% if current_status.value == 'MASTERED' %}
            <div style="display: flex; align-items: center; gap: 6px; padding: 6px 14px; background: rgba(206, 145, 120, 0.2); border: 1px solid rgba(206, 145, 120, 0.5); border-radius: 4px; color: #e5a085; font-weight: 600; font-size: 12px;">
                {{ icons.icon('award', 16) }}
                <span>DOMINADO &bull; 100% XP</span>
            </div>
        {% elseif current_status.value == 'COMPLETED' %}
            <div style="display: flex; align-items: center; gap: 6px; padding: 6px 14px; background: rgba(137, 209, 133, 0.15); border: 1px solid rgba(137, 209, 133, 0.4); border-radius: 4px; color: var(--accent-success); font-weight: 600; font-size: 12px;">
                {{ icons.icon('check-circle', 16) }}
                <span>COMPLETADA &bull; +50 XP</span>
            </div>
        {% else %}
            <form action="{{ path('app_lesson_complete', {lessonSlug: lesson.slug}) }}" method="POST">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button type="submit" class="btn-vs">
                    {{ icons.icon('check-circle', 14) }}
                    <span>Marcar como Completada</span>
                </button>
            </form>
        {% endif %}
    </div>
</div>

<!-- Navigation Anchors for Quick Jump -->
<div class="lesson-quick-nav" style="display: flex; gap: 10px; margin-bottom: 24px; border-bottom: 1px solid var(--border-light); padding-bottom: 10px; flex-wrap: wrap;">
    <a href="#teoria" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
        {{ icons.icon('help-circle', 13) }} <span>Concepto &amp; Internals</span>
    </a>
    {% if details.mental_model is defined and details.mental_model %}
        <a href="#mental-model" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
            {{ icons.icon('cpu', 13) }} <span>Modelo Mental CS50</span>
        </a>
    {% endif %}
    {% if details.video is defined and details.video %}
        <a href="#video-masterclass" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
            {{ icons.icon('video', 13) }} <span>Video Masterclass</span>
        </a>
    {% endif %}
    {% if details.deep_dive is defined and details.deep_dive %}
        <a href="#masterclass" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
            {{ icons.icon('book-open', 13) }} <span>Masterclass Teórica</span>
        </a>
    {% endif %}
    <a href="#codigo-referencia" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
        {{ icons.icon('file-code', 13) }} <span>Código de Referencia</span>
    </a>
    <a href="#senior-thinking" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
        {{ icons.icon('award', 13) }} <span>Pensamiento Senior</span>
    </a>
    <a href="#junior-vs-senior" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
        {{ icons.icon('sliders', 13) }} <span>Junior vs Senior</span>
    </a>
    {% if (details.citations is defined and details.citations) or (details.external_references is defined and details.external_references) %}
        <a href="#referencias-tecnicas" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
            {{ icons.icon('external-link', 13) }} <span>Citas &amp; Referencias</span>
        </a>
    {% endif %}
    <a href="#exercise-section" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
        {{ icons.icon('terminal', 13) }} <span>Reto de Código &amp; Guía</span>
    </a>
    <a href="#quiz-section" class="menu-item" style="display: flex; align-items: center; gap: 5px;">
        {{ icons.icon('check-square', 13) }} <span>Quiz de Evaluación</span>
    </a>
</div>

<!-- 1. Concepto y Problema -->
<div id="teoria" style="margin-bottom: 28px;">
    <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        {{ icons.icon('help-circle', 16) }}
        <span>1. Qué problema resuelve y por qué existe</span>
    </h2>
    <div style="background: #181818; border: 1px solid var(--border-main); border-radius: 6px; padding: 18px; margin-bottom: 16px;">
        <p style="color: #cccccc; font-size: 13.5px; line-height: 1.7; margin-bottom: 12px;">
            {{ details.overview.concept }}
        </p>
        <div class="lesson-problem-solution-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 14px;">
            <div style="background: #201515; border-left: 3px solid var(--accent-red); padding: 12px 14px; border-radius: 0 4px 4px 0;">
                <div style="font-size: 12px; font-weight: 700; color: var(--accent-red); margin-bottom: 4px;">{{ details.overview.problem_label ?? 'El Problema Arquitectural:' }}</div>
                <div style="font-size: 12.5px; color: #d4d4d4; line-height: 1.6;">{{ details.overview.problem }}</div>
            </div>
            <div style="background: #152218; border-left: 3px solid var(--accent-success); padding: 12px 14px; border-radius: 0 4px 4px 0;">
                <div style="font-size: 12px; font-weight: 700; color: var(--accent-success); margin-bottom: 4px;">{{ details.overview.solution_label ?? 'La Solución de Diseño Senior:' }}</div>
                <div style="font-size: 12.5px; color: #d4d4d4; line-height: 1.6;">{{ details.overview.solution }}</div>
            </div>
        </div>
    </div>
</div>

<!-- Modelo Mental CS50 (Analogía Visual y Física) -->
{% if details.mental_model is defined and details.mental_model %}
<div id="mental-model" style="margin-bottom: 28px;">
    <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        {{ icons.icon('cpu', 16) }}
        <span>Modelo Mental CS50: {{ details.mental_model.title }}</span>
    </h2>
    <div style="background: #191b22; border: 1px solid rgba(79, 193, 255, 0.3); border-left: 4px solid #4fc1ff; border-radius: 0 6px 6px 0; padding: 20px;">
        <div style="font-size: 11px; font-weight: 700; color: #4fc1ff; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
            {{ icons.icon('help-circle', 14) }}
            <span>La Analogía del Mundo Real</span>
        </div>
        <p style="color: #e0e0e0; font-size: 13.5px; line-height: 1.7; margin: 0 0 14px 0;">
            {{ details.mental_model.analogy|sanitize_html('app.lesson_content') }}
        </p>
        {% if details.mental_model.ascii_diagram is defined and details.mental_model.ascii_diagram %}
            <div style="background: #0f1117; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 4px; padding: 14px; margin-bottom: 14px; overflow-x: auto;">
                <pre style="margin: 0; font-family: var(--font-mono); font-size: 12px; color: #89d185; line-height: 1.45;">{{ details.mental_model.ascii_diagram }}</pre>
            </div>
        {% endif %}
        <div style="background: rgba(0, 0, 0, 0.3); border-radius: 4px; padding: 10px 14px; display: flex; align-items: flex-start; gap: 8px;">
            <span style="color: #f59e0b; margin-top: 1px;">{{ icons.icon('check-circle', 14) }}</span>
            <div style="font-size: 12.5px; color: #cccccc; line-height: 1.5;">
                <strong style="color: #ffffff;">Conexión con la Arquitectura:</strong> {{ details.mental_model.key_concept }}
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- 2. Cómo funciona internamente (Internals) -->
<div style="margin-bottom: 28px;">
    <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        {{ icons.icon('cpu', 16) }}
        <span>2. {{ details.internals.title }}</span>
    </h2>
    
    <div style="background: #181818; border: 1px solid var(--border-main); border-radius: 6px; padding: 18px;">
        <div style="display: flex; flex-direction: column; gap: 14px;">
            {% for step in details.internals.steps %}
                <div style="display: flex; gap: 12px; align-items: flex-start;">
                    <span class="user-badge" style="background: rgba(0, 122, 204, 0.15); border-color: rgba(0, 122, 204, 0.4); color: #4fc1ff; white-space: nowrap; margin-top: 2px;">
                        Paso {{ loop.index }}
                    </span>
                    <div>
                        <div style="font-weight: 600; color: #ffffff; font-size: 13px; margin-bottom: 3px;">{{ step.phase }}</div>
                        <div style="font-size: 12.5px; color: #cccccc; line-height: 1.6;">{{ step.description }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Masterclass en Video (Conferencia / Deep-Dive) -->
{% if details.video is defined and details.video %}
<div id="video-masterclass" style="margin-bottom: 28px;">
    <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        {{ icons.icon('video', 16) }}
        <span>Video Masterclass: {{ details.video.title }}</span>
    </h2>
    <div style="background: #181818; border: 1px solid var(--border-main); border-radius: 6px; padding: 18px;">
        <div class="lesson-video-grid" style="display: grid; grid-template-columns: 1fr 340px; gap: 20px; align-items: start;">
            <div>
                <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 6px; border: 1px solid #2d2d2d; background: #000000;">
                    <iframe 
                        src="https://www.youtube-nocookie.com/embed/{{ details.video.youtube_id }}" 
                        title="{{ details.video.title }}"
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen
                        loading="lazy"
                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;">
                    </iframe>
                </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-light); padding-bottom: 8px;">
                    <span style="font-size: 11px; font-weight: 700; color: #4fc1ff; text-transform: uppercase;">{{ details.video.speaker|default('Conferencia Técnica') }}</span>
                    <span style="font-size: 11px; color: #858585;">{{ details.video.duration }}</span>
                </div>
                <p style="font-size: 12.5px; color: #cccccc; line-height: 1.6; margin: 0;">
                    {{ details.video.description }}
                </p>
                {% if details.video.chapters is defined and details.video.chapters %}
                    <div style="background: #121212; border: 1px solid var(--border-light); border-radius: 4px; padding: 10px 12px;">
                        <div style="font-size: 11px; font-weight: 700; color: #858585; text-transform: uppercase; margin-bottom: 6px;">Capítulos Clave:</div>
                        <ul style="margin: 0; padding-left: 16px; font-size: 11.5px; color: #9cdcfe; line-height: 1.7;">
                            {% for time, chapter in details.video.chapters %}
                                <li><strong>{{ time }}</strong> &mdash; {{ chapter }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if details.video.key_takeaways is defined and details.video.key_takeaways %}
                    <div style="background: #121212; border: 1px solid var(--border-light); border-radius: 4px; padding: 10px 12px;">
                        <div style="font-size: 11px; font-weight: 700; color: #858585; text-transform: uppercase; margin-bottom: 6px;">Ideas Clave:</div>
                        <ul style="margin: 0; padding-left: 16px; font-size: 11.5px; color: #cccccc; line-height: 1.7;">
                            {% for takeaway in details.video.key_takeaways %}
                                <li>{{ takeaway }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- Masterclass: Teoría Profunda Paso a Paso -->
{% if details.deep_dive is defined and details.deep_dive %}
<div id="masterclass" style="margin-bottom: 28px;">
    <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        {{ icons.icon('book-open', 16) }}
        <span>Fundamentos Teóricos &amp; Explicación Paso a Paso</span>
    </h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
        {% for section in details.deep_dive %}
            <div style="background: #181818; border: 1px solid var(--border-main); border-left: 3px solid var(--accent-blue); border-radius: 0 6px 6px 0; padding: 18px 20px;">
                <h3 style="font-size: 14px; font-weight: 700; color: #9cdcfe; margin: 0 0 10px 0; display: flex; align-items: center; gap: 8px;">
                    {{ icons.icon(section.icon|default('file-text'), 15) }}
                    <span>{{ section.title }}</span>
                </h3>
                <div style="color: #cccccc; font-size: 13px; line-height: 1.7; margin-bottom: section.code is defined ? 12px : 0;">
                    {{ section.content|sanitize_html('app.lesson_content') }}
                </div>
                {% if section.code is defined and section.code %}
                    <div style="background: #121212; border: 1px solid var(--border-light); border-radius: 4px; padding: 12px 14px; font-family: var(--font-mono); font-size: 12px; color: #d4d4d4; overflow-x: auto; white-space: pre-wrap; line-height: 1.5; margin-top: 10px;">{{ section.code }}</div>
                {% endif %}
                {% if section.takeaways is defined and section.takeaways %}
                    <div style="margin-top: 12px; background: rgba(0, 122, 204, 0.08); border: 1px solid rgba(0, 122, 204, 0.25); border-radius: 4px; padding: 10px 14px;">
                        <span style="font-size: 11.5px; font-weight: 700; color: #4fc1ff; text-transform: uppercase; letter-spacing: 0.5px;">Conclusión Clave:</span>
                        <p style="font-size: 12px; color: #d4d4d4; margin: 4px 0 0 0; line-height: 1.5;">{{ section.takeaways }}</p>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- 3. Código Arquitectural de Referencia estilo VS Code -->
<div id="codigo-referencia" class="editor-code-container" style="margin-bottom: 28px;">
    <div class="editor-code-header">
        <div class="editor-code-title">
            {{ icons.icon('file-code', 14) }}
            <span>{{ details.architecture_code.filename ?? 'ArchitectureReference.php' }} &mdash; {{ details.architecture_code.title ?? 'Implementación Arquitectónica de Referencia' }}</span>
        </div>
        <span class="user-badge" style="background: rgba(0, 122, 204, 0.15); border-color: rgba(0, 122, 204, 0.4); color: #4fc1ff; font-size: 11px;">
            {{ details.architecture_code.tag ?? 'PHP 8.4 Senior Pattern' }}
        </span>
    </div>
    <div class="editor-code-body" style="padding: 16px; overflow-x: auto; background: #181818; line-height: 1.6;">
        <pre style="margin: 0; font-family: var(--font-mono); font-size: 12.5px; color: #d4d4d4; white-space: pre-wrap;"><code>{{ details.architecture_code.code ?? "declare(strict_types=1);\n\n// Código arquitectural de referencia\n" }}</code></pre>
    </div>
</div>

<!-- 4. Cómo lo pensaría un Senior -->
<div id="senior-thinking" class="senior-thinking-callout">
    <div class="senior-thinking-title">
        {{ icons.icon('award', 18) }}
        <span>Cómo lo pensaría un Senior: Proceso Mental y Preguntas Críticas</span>
    </div>
    {% if details.senior_mindset is iterable %}
        <p style="color: #d4d4d4; font-size: 13.5px; line-height: 1.7; margin-bottom: 14px;">
            {{ details.senior_mindset.thought_process|default('') }}
        </p>
        {% if details.senior_mindset.critical_questions is defined and details.senior_mindset.critical_questions|length > 0 %}
            <div style="font-weight: 600; color: #ffffff; font-size: 12.5px; margin-bottom: 8px;">Preguntas que deberías hacerte antes de implementar esto:</div>
            <ul style="margin-left: 20px; color: #d4d4d4; font-size: 12.5px; line-height: 1.7;">
                {% for q in details.senior_mindset.critical_questions %}
                    <li>{{ q }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    {% else %}
        <p style="color: #d4d4d4; font-size: 13.5px; line-height: 1.7; margin-bottom: 14px;">
            {{ details.senior_mindset }}
        </p>
    {% endif %}
</div>

<!-- 5. Comparador Junior vs Senior Thinking -->
{% set comparison = details.junior_vs_senior %}
<div id="junior-vs-senior" style="margin-top: 32px; margin-bottom: 32px;">
    <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        {{ icons.icon('sliders', 16) }}
        <span>Junior vs Senior Thinking: Análisis de Caso Real</span>
    </h2>
    <div style="font-size: 12.5px; color: var(--text-muted); margin-bottom: 14px;">
        <strong>Escenario:</strong> {{ details.junior_vs_senior.problem_statement|default('Escenario de arquitectura y desarrollo en producción.') }}
    </div>

    <div class="senior-diff-grid">
        <div class="diff-column junior">
            <div class="diff-column-header">
                <span style="color: var(--accent-red);">Junior Developer Approach</span>
                <span>Foco en terminar rápido</span>
            </div>
            <div class="diff-column-body">
                <div style="font-weight: 600; color: #ffffff; margin-bottom: 8px;">Implementación:</div>
                {% if details.junior_vs_senior.junior is iterable %}
                    <p style="font-size: 12px; color: #cccccc; margin-bottom: 12px;">{{ details.junior_vs_senior.junior.approach|default(details.junior_vs_senior.junior.title|default('')) }}</p>
                    {% if details.junior_vs_senior.junior.code is defined and details.junior_vs_senior.junior.code %}
                        <pre class="diff-code"><code>{{ details.junior_vs_senior.junior.code }}</code></pre>
                    {% endif %}
                    <div style="font-weight: 600; color: var(--accent-red); margin-bottom: 6px;">Fallas Críticas &amp; Cuellos de Botella:</div>
                    {% for flaw in details.junior_vs_senior.junior.flaws|default(details.junior_vs_senior.junior.consequences|default([])) %}
                        <div class="diff-point">{{ flaw }}</div>
                    {% endfor %}
                {% else %}
                    <p style="font-size: 12px; color: #cccccc; margin-bottom: 12px;">{{ details.junior_vs_senior.junior }}</p>
                {% endif %}
            </div>
        </div>

        <div class="diff-column senior">
            <div class="diff-column-header">
                <span style="color: var(--accent-success);">Senior Software Engineer</span>
                <span>Foco en arquitectura &amp; escalabilidad</span>
            </div>
            <div class="diff-column-body">
                <div style="font-weight: 600; color: #ffffff; margin-bottom: 8px;">Solución Arquitectónica:</div>
                {% if details.junior_vs_senior.senior is iterable %}
                    <p style="font-size: 12px; color: #cccccc; margin-bottom: 12px;">{{ details.junior_vs_senior.senior.approach|default(details.junior_vs_senior.senior.title|default('')) }}</p>
                    {% if details.junior_vs_senior.senior.code is defined and details.junior_vs_senior.senior.code %}
                        <pre class="diff-code"><code>{{ details.junior_vs_senior.senior.code }}</code></pre>
                    {% endif %}
                    <div style="font-weight: 600; color: var(--accent-success); margin-bottom: 6px;">Justificación de Valor:</div>
                    {% for rationale in details.junior_vs_senior.senior.rationale|default(details.junior_vs_senior.senior.benefits|default([])) %}
                        <div class="diff-point">{{ rationale }}</div>
                    {% endfor %}
                    {% set tradeOffs = details.junior_vs_senior.senior.trade_offs|default(details.junior_vs_senior.trade_offs|default(null)) %}
                    {% if tradeOffs %}
                        <div style="margin-top: 12px; font-size: 11.5px; color: #858585; border-top: 1px solid var(--border-light); padding-top: 8px;">
                            <strong>Trade-offs:</strong>
                            {% if tradeOffs is iterable %}
                                <ul style="margin: 4px 0 0 16px; padding: 0;">
                                    {% for to in tradeOffs %}
                                        <li>{{ to }}</li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                {{ tradeOffs }}
                            {% endif %}
                        </div>
                    {% endif %}
                {% else %}
                    <p style="font-size: 12px; color: #cccccc; margin-bottom: 12px;">{{ details.junior_vs_senior.senior }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Citas Técnicas, Enlaces Externos & Bibliografía Canónica -->
{% if (details.citations is defined and details.citations) or (details.external_references is defined and details.external_references) %}
<div id="referencias-tecnicas" style="margin-top: 32px; margin-bottom: 32px;">
    <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        {{ icons.icon('external-link', 16) }}
        <span>Citas Técnicas, Enlaces Externos &amp; Bibliografía Canónica</span>
    </h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
        {% if details.citations is defined and details.citations %}
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px;">
                {% for citation in details.citations %}
                    <div style="background: #181818; border: 1px solid var(--border-main); border-left: 3px solid #f59e0b; border-radius: 0 6px 6px 0; padding: 16px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                            <span style="font-size: 11px; font-weight: 700; color: #f59e0b; text-transform: uppercase; letter-spacing: 0.5px;">{{ citation.topic }}</span>
                            <span style="font-size: 11px; color: #858585;">{{ citation.source }}</span>
                        </div>
                        <blockquote style="margin: 0 0 10px 0; font-style: italic; color: #e5e5e5; font-size: 12.5px; line-height: 1.6; border-left: 2px solid #333333; padding-left: 10px;">
                            &ldquo;{{ citation.quote }}&rdquo;
                        </blockquote>
                        <div style="font-size: 11.5px; color: #858585; text-align: right;">&mdash; <strong>{{ citation.author }}</strong></div>
                        <div style="margin-top: 10px; font-size: 12px; color: #cccccc; line-height: 1.5; background: #121212; padding: 8px 10px; border-radius: 4px;">
                            <strong style="color: #9cdcfe;">Por qué importa entenderlo:</strong> {{ citation.explanation }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if details.external_references is defined and details.external_references %}
            <div style="background: #181818; border: 1px solid var(--border-main); border-radius: 6px; padding: 16px;">
                <div style="font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 6px;">
                    {{ icons.icon('book-open', 14) }}
                    <span>Documentación Oficial &amp; Especificaciones Técnicas Recomendadas:</span>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px;">
                    {% for ref in details.external_references %}
                        <a href="{{ ref.url }}" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; justify-content: space-between; background: #121212; border: 1px solid var(--border-light); border-radius: 4px; padding: 10px 12px; text-decoration: none;" class="ref-link">
                            <div style="flex: 1; min-width: 0; padding-right: 8px;">
                                <div style="font-size: 12.5px; font-weight: 600; color: #4fc1ff; display: flex; align-items: center; gap: 5px;">
                                    <span>{{ ref.title }}</span>
                                    {{ icons.icon('external-link', 11) }}
                                </div>
                                {% if ref.description is defined %}
                                    <div style="font-size: 11px; color: #858585; margin-top: 2px;">{{ ref.description }}</div>
                                {% endif %}
                            </div>
                            <span class="user-badge" style="background: rgba(0, 122, 204, 0.15); border-color: rgba(0, 122, 204, 0.4); color: #4fc1ff; font-size: 10px; white-space: nowrap;">
                                {{ ref.type|default('DOCS') }}
                            </span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endif %}

<!-- 6. Laboratorio de Ejercicio & Reto de Código -->
<div id="exercise-section" style="margin-top: 36px; margin-bottom: 36px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; display: flex; align-items: center; gap: 8px;">
            {{ icons.icon('terminal', 16) }}
            <span>6. {{ details.exercise.title }}</span>
        </h2>
        {% if latest_exercise %}
            <span class="user-badge" style="{{ latest_exercise.isPassed ? 'background: rgba(137,209,133,0.15); color: #89d185; border-color: rgba(137,209,133,0.4);' : 'background: rgba(241,76,76,0.15); color: #f14c4c; border-color: rgba(241,76,76,0.4);' }}">
                {{ latest_exercise.isPassed ? 'Reto Superado' : 'Requiere Ajustes' }}
            </span>
        {% endif %}
    </div>

    <div style="background: #181818; border: 1px solid var(--border-main); border-radius: 6px; padding: 18px; margin-bottom: 14px;">
        <div style="font-size: 13px; color: #d4d4d4; margin-bottom: 10px;">
            <strong>Objetivo:</strong> {{ details.exercise.objective }}
        </div>
        <div style="font-size: 12.5px; color: var(--text-muted); margin-bottom: 14px; white-space: pre-line;">
            {{- details.exercise.instructions -}}
        </div>

        <!-- Guía Didáctica y Explicación del Reto -->
        {% if details.exercise.guide is defined and details.exercise.guide %}
            <div style="background: #202020; border: 1px solid rgba(0, 122, 204, 0.35); border-left: 4px solid var(--accent-blue); border-radius: 0 4px 4px 0; padding: 16px 18px; margin-bottom: 18px;">
                <div style="font-size: 13px; font-weight: 700; color: #9cdcfe; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                    {{ icons.icon('help-circle', 15) }}
                    <span>Guía Didáctica para Resolver este Reto</span>
                </div>
                {% if details.exercise.guide.explanation is defined %}
                    <div style="font-size: 12.5px; color: #d4d4d4; line-height: 1.6; margin: 0 0 12px 0;">
                        {{ details.exercise.guide.explanation|sanitize_html('app.lesson_content') }}
                    </div>
                {% endif %}

                {% if details.exercise.guide.steps is defined and details.exercise.guide.steps %}
                    <div style="font-size: 11.5px; font-weight: 700; color: #ffffff; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
                        Paso a Paso del Algoritmo:
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px;">
                        {% for step in details.exercise.guide.steps %}
                            <div style="display: flex; gap: 10px; align-items: flex-start; font-size: 12.5px; color: #cccccc; background: #161616; padding: 10px 12px; border-radius: 4px; border: 1px solid var(--border-light);">
                                <span style="font-family: var(--font-mono); color: #4fc1ff; font-weight: 700; min-width: 22px;">0{{ loop.index }}.</span>
                                <div style="line-height: 1.5;">{{ step|sanitize_html('app.lesson_content') }}</div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if details.exercise.guide.useful_functions is defined and details.exercise.guide.useful_functions %}
                    <div style="background: #121212; border: 1px solid var(--border-light); border-radius: 4px; padding: 10px 14px;">
                        <span style="font-size: 11px; font-weight: 700; color: #89d185; text-transform: uppercase;">Funciones Nativas de PHP Clave:</span>
                        <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 6px;">
                            {% for fn in details.exercise.guide.useful_functions %}
                                <div style="font-size: 12px; font-family: var(--font-mono); color: #dcdcaa;">
                                    &bull; <strong style="color: #9cdcfe;">{{ fn.name }}</strong>: <span style="color: #cccccc;">{{ fn.desc }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        <!-- Pistas Progresivas de Razonamiento (Scaffolded Hints) -->
        {% if details.exercise.hints is defined and details.exercise.hints %}
            <div style="background: #17181c; border: 1px solid var(--border-main); border-radius: 6px; padding: 14px 16px; margin-bottom: 18px;">
                <div style="font-size: 12px; font-weight: 700; color: #9cdcfe; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                    {{ icons.icon('help-circle', 14) }}
                    <span>¿Atascado en el reto? Pistas Progresivas de Razonamiento:</span>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 6px;">
                    {% for hintIndex, hint in details.exercise.hints %}
                        <button type="button" class="btn-vs btn-vs-secondary" style="font-size: 11px; padding: 4px 10px;" onclick="toggleHint('hint-{{ hintIndex }}')">
                            {{ icons.icon('help-circle', 11) }}
                            <span>Pista {{ hintIndex + 1 }}{% if hint.label is defined %}: {{ hint.label }}{% endif %}</span>
                        </button>
                    {% endfor %}
                </div>
                {% for hintIndex, hint in details.exercise.hints %}
                    <div id="hint-{{ hintIndex }}" style="display: none; margin-top: 8px; background: #111215; border-left: 3px solid #4fc1ff; border-radius: 0 4px 4px 0; padding: 10px 14px; font-size: 12px; color: #d4d4d4; line-height: 1.6;">
                        <strong style="color: #4fc1ff;">Pista {{ hintIndex + 1 }}{% if hint.label is defined %} &mdash; {{ hint.label }}{% endif %}:</strong>
                        <div style="margin-top: 4px;">{{ hint.text|sanitize_html('app.lesson_content') }}</div>
                        {% if hint.snippet is defined and hint.snippet %}
                            <pre style="margin: 8px 0 0 0; background: #0c0d10; padding: 8px 10px; border-radius: 3px; font-family: var(--font-mono); font-size: 11.5px; color: #ce9178; overflow-x: auto;"><code>{{ hint.snippet }}</code></pre>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <!-- Code Editor Form with Monaco Editor -->
        <form id="exercise-form" action="{{ path('app_lesson_exercise', {lessonSlug: lesson.slug}) }}" method="POST">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
            <div style="border: 1px solid var(--border-main); border-radius: 4px; overflow: hidden; margin-bottom: 12px; background: #1e1e1e;">
                <div style="background: #252526; padding: 6px 14px; font-size: 11.5px; color: var(--text-muted); font-family: var(--font-mono); display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-main);">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        {% if details.exercise.language is defined and details.exercise.language == 'markdown' %}
                            {{ icons.icon('file-text', 14) }}
                        {% else %}
                            {{ icons.icon('php', 14) }}
                        {% endif %}
                        <span style="color: var(--text-bright); font-weight: 500;">{{ details.exercise.filename ?? (lesson.slug ~ '.php') }} (Monaco Editor)</span>
                        <span class="user-badge" style="background: rgba(0, 122, 204, 0.15); border-color: rgba(0, 122, 204, 0.4); color: #4fc1ff; font-size: 10.5px;">{{ details.exercise.language_badge|default('PHP 8.4') }}</span>
                    </div>

                    <div style="display: flex; align-items: center; gap: 12px;">
                        <!-- Real-time Lint Badge -->
                        <div id="lint-status-badge">
                            {% if details.exercise.language is defined and details.exercise.language == 'markdown' %}
                                <span style="color: var(--accent-success); display: flex; align-items: center; gap: 4px;">
                                    {{ icons.icon('check-circle', 12) }}
                                    <span>Especificación técnica (Markdown / Gherkin)</span>
                                </span>
                            {% else %}
                                <span style="color: var(--accent-success); display: flex; align-items: center; gap: 4px;">
                                    {{ icons.icon('check-circle', 12) }}
                                    <span>Sintaxis válida (0 errores)</span>
                                </span>
                            {% endif %}
                        </div>

                        <!-- Editor Actions -->
                        <button type="button" class="btn-vs btn-vs-secondary" style="font-size: 11px; padding: 2px 8px;" onclick="formatCode()" title="Formatear Código (Shift+Alt+F)">
                            {{ icons.icon('code', 11) }}
                            <span>Formatear</span>
                        </button>
                        <button type="button" class="btn-vs btn-vs-secondary" style="font-size: 11px; padding: 2px 8px;" onclick="resetCode()" title="Restablecer Código Inicial">
                            {{ icons.icon('refresh-cw', 10) }}
                            <span>Restablecer</span>
                        </button>
                    </div>
                </div>

                <!-- Monaco Container -->
                <div id="monaco-editor" style="height: 380px; width: 100%;"></div>

                <!-- Fallback & Form Submission Input -->
                <textarea id="fallback-code" name="submitted_code" style="display: none;">{{ latest_exercise ? latest_exercise.submittedCode : details.exercise.starter_code }}</textarea>
            </div>

            <div style="display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap;">
                <button type="submit" class="btn-vs">
                    {{ icons.icon('play', 13) }}
                    <span>Ejecutar y Validar Reto</span>
                </button>
                <button type="button" class="btn-vs btn-vs-secondary" onclick="document.getElementById('solutionBlock').style.display = document.getElementById('solutionBlock').style.display === 'none' ? 'block' : 'none';">
                    {{ icons.icon('file-code', 13) }}
                    <span>Ver Solución Senior Explicada</span>
                </button>
            </div>
        </form>

        <!-- Solution Block (Collapsible) -->
        <div id="solutionBlock" style="display: none; margin-top: 16px; border-top: 1px solid var(--border-light); padding-top: 14px;">
            <div style="font-size: 12px; font-weight: 700; color: #4fc1ff; margin-bottom: 8px;">Solución de Referencia Senior:</div>
            <pre style="background: #141414; border: 1px solid var(--border-main); border-radius: 4px; padding: 12px; font-family: var(--font-mono); font-size: 12px; color: #89d185; overflow-x: auto;"><code>{{ details.exercise.solution_code }}</code></pre>
            <p style="font-size: 12px; color: #a0a0a0; margin-top: 8px;">{{ details.exercise.explanation }}</p>
        </div>
    </div>
</div>

<!-- 7. Evaluación Técnica: Quiz Senior -->
<div id="quiz-section" style="margin-top: 36px; margin-bottom: 36px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; display: flex; align-items: center; gap: 8px;">
            {{ icons.icon('award', 16) }}
            <span>7. {{ details.quiz.title }}</span>
        </h2>
        {% if latest_quiz %}
            <span class="user-badge" style="{{ latest_quiz.isPassed ? 'background: rgba(137,209,133,0.15); color: #89d185; border-color: rgba(137,209,133,0.4);' : 'background: rgba(241,76,76,0.15); color: #f14c4c; border-color: rgba(241,76,76,0.4);' }}">
                Puntaje: {{ latest_quiz.scorePercentage }}% &bull; {{ latest_quiz.isPassed ? 'Aprobado' : 'Pendiente' }}
            </span>
        {% endif %}
    </div>

    <form action="{{ path('app_lesson_quiz', {lessonSlug: lesson.slug}) }}" method="POST">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
        <div style="display: flex; flex-direction: column; gap: 16px;">
            {% for q in details.quiz.questions %}
                <div style="background: #181818; border: 1px solid var(--border-main); border-radius: 6px; padding: 18px;">
                    <div style="font-size: 13.5px; font-weight: 600; color: #ffffff; margin-bottom: 12px;">
                        {{ loop.index }}. {{ q.question }}
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        {% for optKey, optText in q.options %}
                            <label style="display: flex; align-items: center; gap: 10px; padding: 8px 12px; background: #252526; border: 1px solid var(--border-light); border-radius: 4px; cursor: pointer; font-size: 12.5px; color: #d4d4d4;">
                                <input type="radio" name="answers[{{ q.id }}]" value="{{ optKey }}" required 
                                    {{ latest_quiz and latest_quiz.answers[q.id]|default('') == optKey ? 'checked' : '' }}>
                                <span><strong>{{ optKey|upper }})</strong> {{ optText }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}

            <div style="margin-top: 10px;">
                <button type="submit" class="btn-vs">
                    {{ icons.icon('check-circle', 14) }}
                    <span>Enviar Evaluación y Calificar</span>
                </button>
            </div>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js"></script>
<script>
    require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });

    let editorInstance = null;
    const initialCode = {{ (latest_exercise ? latest_exercise.submittedCode : details.exercise.starter_code)|json_encode|raw }};
    const starterCode = {{ details.exercise.starter_code|json_encode|raw }};

    require(['vs/editor/editor.main'], function () {
        // Register custom IntelliSense completions for Senior PHP
        monaco.languages.registerCompletionItemProvider('php', {
            provideCompletionItems: function(model, position) {
                const suggestions = [
                    {
                        label: 'strict_types',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: 'declare(strict_types=1);\n',
                        documentation: 'Declaración de tipado estricto requerida para PHP moderno y arquitecturas Senior.'
                    },
                    {
                        label: 'readonly class',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: "readonly class ${1:ClassName}\n{\n    public function __construct(\n        public ${2:string} $${3:property}\n    ) {}\n}",
                        insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                        documentation: 'Clase inmutable de PHP 8.2+ con propiedades readonly por defecto.'
                    },
                    {
                        label: 'enum',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: "enum ${1:Status}: ${2|string,int|}\n{\n    case ${3:CaseName} = '${4:value}';\n\n    public function isTerminal(): bool\n    {\n        return match (\$this) {\n            self::${3:CaseName} => false,\n        };\n    }\n}",
                        insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                        documentation: 'Backed Enum de PHP 8.1+ para modelar estados finitos seguros.'
                    },
                    {
                        label: 'interface',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: "interface ${1:ContractName}Interface\n{\n    public function ${2:execute}(${3:\$param}): ${4:void};\n}",
                        insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                        documentation: 'Interfaz para desacoplar comportamiento y aplicar el principio de composición sobre herencia.'
                    },
                    {
                        label: 'match',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: "\$result = match (\$${1:variable}) {\n    ${2:Condition} => ${3:Value},\n    default => ${4:DefaultValue},\n};",
                        insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                        documentation: 'Expresión match exhaustiva con verificación estricta de tipos de PHP 8.0+.'
                    },
                    {
                        label: 'DomainException',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: "throw new \\DomainException('${1:Mensaje de violación de invariante}');",
                        insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                        documentation: 'Excepción de dominio semántica para salvaguardar invariantes de negocio.'
                    },
                    {
                        label: 'microtime',
                        kind: monaco.languages.CompletionItemKind.Function,
                        insertText: 'microtime(true)',
                        documentation: 'Obtiene el timestamp actual de Unix con microsegundos en coma flotante (float).'
                    },
                    {
                        label: 'TwigFilter',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: "new TwigFilter('${1:filter_name}', [\$this, '${2:methodName}'], ['is_safe' => ['html']])",
                        insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                        documentation: 'Registro de filtro tipado para Twig Extension.'
                    },
                    {
                        label: 'TwigFunction',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: "new TwigFunction('${1:function_name}', [\$this, '${2:methodName}'])",
                        insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                        documentation: 'Registro de función auxiliar para plantillas Twig.'
                    },
                    {
                        label: 'htmlspecialchars',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: "htmlspecialchars(\$${1:text}, ENT_QUOTES, 'UTF-8')",
                        insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                        documentation: 'Escapado seguro de entidades HTML conforme a estándares de defensa contra XSS.'
                    },
                    {
                        label: 'InvalidArgumentException',
                        kind: monaco.languages.CompletionItemKind.Snippet,
                        insertText: "throw new \\InvalidArgumentException('${1:Mensaje de validación de argumento}');",
                        insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                        documentation: 'Excepción estándar lanzada cuando un argumento no respeta las restricciones requeridas.'
                    }
                ];
                return { suggestions: suggestions };
            }
        });

        // Initialize Monaco Editor
        editorInstance = monaco.editor.create(document.getElementById('monaco-editor'), {
            value: initialCode,
            language: '{{ details.exercise.language|default("php") }}',
            theme: 'vs-dark',
            automaticLayout: true,
            fontSize: 13,
            fontFamily: '"JetBrains Mono", Consolas, "Cascadia Code", "Fira Code", monospace',
            lineNumbers: 'on',
            tabSize: 4,
            insertSpaces: true,
            minimap: { enabled: false },
            scrollBeyondLastLine: false,
            renderWhitespace: 'selection',
            bracketPairColorization: { enabled: true },
            suggestOnTriggerCharacters: true,
            formatOnPaste: true,
            formatOnType: true
        });

        // Real-time debounced linter
        let lintTimeout = null;
        editorInstance.onDidChangeModelContent(function() {
            document.getElementById('fallback-code').value = editorInstance.getValue();
            clearTimeout(lintTimeout);
            lintTimeout = setTimeout(runLinter, 400);
        });

        runLinter();
    });

    function runLinter() {
        if (!editorInstance) return;
        const exerciseLang = '{{ details.exercise.language|default("php") }}';
        if (exerciseLang !== 'php') return;
        const code = editorInstance.getValue();
        const badge = document.getElementById('lint-status-badge');

        fetch('{{ path("app_api_lint") }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: code })
        })
        .then(res => res.json())
        .then(data => {
            const model = editorInstance.getModel();
            const markers = [];

            if (!data.valid && data.errors && data.errors.length > 0) {
                data.errors.forEach(err => {
                    markers.push({
                        startLineNumber: err.line,
                        startColumn: 1,
                        endLineNumber: err.line,
                        endColumn: 1000,
                        message: err.message,
                        severity: monaco.MarkerSeverity.Error
                    });
                });
                monaco.editor.setModelMarkers(model, 'php-linter', markers);
                badge.innerHTML = '<span style="color: var(--accent-red); display: flex; align-items: center; gap: 4px;">{{ icons.icon("shield", 12)|escape("js") }} <span>Error sintáctico en línea ' + data.errors[0].line + '</span></span>';
            } else {
                monaco.editor.setModelMarkers(model, 'php-linter', []);
                badge.innerHTML = '<span style="color: var(--accent-success); display: flex; align-items: center; gap: 4px;">{{ icons.icon("check-circle", 12)|escape("js") }} <span>Sintaxis válida (0 errores)</span></span>';
            }
        })
        .catch(() => {});
    }

    function formatCode() {
        if (editorInstance) {
            editorInstance.getAction('editor.action.formatDocument').run();
        }
    }

    function toggleHint(id) {
        const el = document.getElementById(id);
        if (el) {
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
        }
    }

    function resetCode() {
        if (editorInstance && confirm('¿Deseas restablecer el código al estado inicial?')) {
            editorInstance.setValue(starterCode);
            document.getElementById('fallback-code').value = starterCode;
            runLinter();
        }
    }

    document.getElementById('exercise-form').addEventListener('submit', function() {
        if (editorInstance) {
            document.getElementById('fallback-code').value = editorInstance.getValue();
        }
    });
</script>
{% endblock %}
