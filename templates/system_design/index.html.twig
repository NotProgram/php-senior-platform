{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}System Design Studio | Apple Glass Edition | Senior DevLab{% endblock %}

{% block stylesheets %}
<style>
    /* Apple Minimalist Glass Canvas & Workspace */
    .sd-workspace {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: calc(100vh - 120px);
        position: relative;
    }

    /* Ambient Radiant Backdrop Glow Orbs */
    .sd-ambient-glow {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }
    .sd-orb-1 {
        position: absolute;
        top: -40px;
        left: 10%;
        width: 380px;
        height: 380px;
        background: radial-gradient(circle, rgba(10, 132, 255, 0.18) 0%, rgba(10, 132, 255, 0) 70%);
        filter: blur(80px);
        border-radius: 50%;
        animation: floatOrb 18s ease-in-out infinite alternate;
    }
    .sd-orb-2 {
        position: absolute;
        top: 250px;
        right: 8%;
        width: 420px;
        height: 420px;
        background: radial-gradient(circle, rgba(191, 90, 242, 0.14) 0%, rgba(191, 90, 242, 0) 70%);
        filter: blur(95px);
        border-radius: 50%;
        animation: floatOrb 22s ease-in-out infinite alternate-reverse;
    }
    .sd-orb-3 {
        position: absolute;
        bottom: 20px;
        left: 30%;
        width: 340px;
        height: 340px;
        background: radial-gradient(circle, rgba(48, 209, 88, 0.12) 0%, rgba(48, 209, 88, 0) 70%);
        filter: blur(85px);
        border-radius: 50%;
        animation: floatOrb 15s ease-in-out infinite alternate;
    }

    @keyframes floatOrb {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(30px, -25px) scale(1.08); }
        100% { transform: translate(-25px, 20px) scale(0.95); }
    }

    /* Apple Frosted Glass Top Navigation */
    .sd-header-glass {
        position: relative;
        z-index: 2;
        background: rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(28px) saturate(190%);
        -webkit-backdrop-filter: blur(28px) saturate(190%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.22), 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        border-radius: 20px;
        padding: 14px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
    }

    .sd-title-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .sd-apple-logo {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.05));
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.4), 0 4px 12px rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 18px;
    }
    .sd-title-text {
        font-size: 17px;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin: 0;
    }
    .sd-subtitle-text {
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.55);
        margin: 0;
    }

    /* Main Split Grid */
    .sd-main-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 16px;
        height: calc(100vh - 200px);
        min-height: 620px;
    }

    @media (max-width: 1080px) {
        .sd-main-grid {
            grid-template-columns: 1fr;
            height: auto;
        }
    }

    /* Frosted Glass Stage Container */
    .sd-stage-glass {
        background: rgba(15, 17, 23, 0.55);
        backdrop-filter: blur(32px) saturate(190%);
        -webkit-backdrop-filter: blur(32px) saturate(190%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.22), 0 20px 48px -12px rgba(0, 0, 0, 0.6);
        border-radius: 22px;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .sd-stage-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1.2px, transparent 1.2px);
        background-size: 24px 24px;
        opacity: 0.85;
        pointer-events: none;
    }

    /* Stage Sub-Toolbar */
    .sd-stage-toolbar {
        background: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 10px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(16px);
        z-index: 5;
    }

    .sd-canvas-viewport {
        flex: 1;
        position: relative;
        overflow: auto;
    }

    /* Apple Glass Squircle Architectural Nodes */
    .sd-node {
        position: absolute;
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(24px) saturate(190%);
        -webkit-backdrop-filter: blur(24px) saturate(190%);
        border: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.25), 0 12px 28px -6px rgba(0, 0, 0, 0.45);
        border-radius: 18px;
        padding: 12px 16px;
        min-width: 170px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 10;
        user-select: none;
    }

    .sd-node:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.3);
        transform: translateY(-4px) scale(1.02);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.35), 0 18px 40px -8px rgba(0, 0, 0, 0.65), 0 0 24px rgba(10, 132, 255, 0.25);
    }

    .sd-node.is-selected {
        background: rgba(10, 132, 255, 0.15);
        border-color: #0a84ff;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.4), 0 16px 36px -6px rgba(10, 132, 255, 0.4), 0 0 0 2px rgba(10, 132, 255, 0.5);
    }

    .sd-node.is-degraded {
        background: rgba(255, 159, 10, 0.15) !important;
        border-color: #ff9f0a !important;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.3), 0 0 24px rgba(255, 159, 10, 0.4) !important;
    }

    .sd-node.is-failed {
        background: rgba(255, 69, 58, 0.18) !important;
        border-color: #ff453a !important;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.3), 0 0 28px rgba(255, 69, 58, 0.5) !important;
        animation: nodeShake 0.4s ease-in-out;
    }

    @keyframes nodeShake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-4px); }
        75% { transform: translateX(4px); }
    }

    .sd-node-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
    }

    .sd-node-squircle {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.35), 0 3px 8px rgba(0, 0, 0, 0.3);
        flex-shrink: 0;
    }

    .sd-node-title {
        font-size: 13px;
        font-weight: 600;
        color: #ffffff;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .sd-node-desc {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.55);
        font-family: var(--font-mono);
    }

    .sd-node-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 8px;
        padding-top: 6px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 10.5px;
    }

    .sd-node-beacon {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #30d158;
        font-weight: 500;
    }

    .sd-pulse-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #30d158;
        box-shadow: 0 0 8px #30d158;
        animation: beaconPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes beaconPulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(1.3); }
    }

    /* Frosted Glass Inspector Panel (Right) */
    .sd-inspector-glass {
        background: rgba(18, 20, 28, 0.65);
        backdrop-filter: blur(36px) saturate(200%);
        -webkit-backdrop-filter: blur(36px) saturate(200%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.22), 0 20px 48px -12px rgba(0, 0, 0, 0.6);
        border-radius: 22px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .sd-inspector-header {
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.09);
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sd-inspector-title {
        font-size: 13.5px;
        font-weight: 600;
        color: #ffffff;
        letter-spacing: -0.01em;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sd-inspector-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    /* Apple Watch Style Minimalist Rings & Telemetry */
    .sd-telemetry-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .sd-metric-box {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        backdrop-filter: blur(12px);
    }

    .sd-ring-wrap {
        width: 38px;
        height: 38px;
        position: relative;
        flex-shrink: 0;
    }

    .sd-ring-wrap svg {
        transform: rotate(-90deg);
        width: 38px;
        height: 38px;
    }

    .sd-ring-bg {
        stroke: rgba(255, 255, 255, 0.1);
        stroke-width: 3.5;
        fill: none;
    }

    .sd-ring-bar {
        stroke-width: 3.5;
        stroke-linecap: round;
        fill: none;
        transition: stroke-dashoffset 0.6s cubic-bezier(0.16, 1, 0.3, 1), stroke 0.3s ease;
    }

    .sd-metric-val {
        font-size: 14px;
        font-weight: 700;
        color: #ffffff;
        font-family: var(--font-mono);
        letter-spacing: -0.02em;
    }

    .sd-metric-lbl {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Animated Flow SVG */
    .flow-line {
        transition: stroke 0.3s ease, stroke-width 0.3s ease;
    }
    .flow-line.is-active {
        stroke-width: 2.5;
    }
    .packet-particle {
        filter: drop-shadow(0 0 6px rgba(10, 132, 255, 0.8));
    }
</style>
{% endblock %}

{% block body %}
<div class="sd-workspace">
    <!-- Radiant Ambient Depth Glow (Apple Minimalist Glass Mesh) -->
    <div class="sd-ambient-glow">
        <div class="sd-orb-1"></div>
        <div class="sd-orb-2"></div>
        <div class="sd-orb-3"></div>
    </div>

    <!-- Apple Frosted Glass Top Navigation Bar -->
    <header class="sd-header-glass">
        <div class="sd-title-wrap">
            <div class="sd-apple-logo"></div>
            <div>
                <h1 class="sd-title-text">System Design Studio</h1>
                <p class="sd-subtitle-text">Arquitecturas Distribuidas &bull; Alta Concurrencia &bull; Resiliencia Enterprise</p>
            </div>
        </div>

        <!-- Apple Segmented Control (Scenario Switcher) -->
        <div class="apple-segmented-control" role="tablist">
            <button type="button" class="apple-segmented-btn is-active" id="btn-scen-ecommerce" onclick="switchScenario('ecommerce')">
                {{ icons.icon('layers', 13) }}
                <span>E-Commerce 10k req/s</span>
            </button>
            <button type="button" class="apple-segmented-btn" id="btn-scen-fintech" onclick="switchScenario('fintech')">
                {{ icons.icon('shield', 13) }}
                <span>Fintech &amp; Outbox</span>
            </button>
            <button type="button" class="apple-segmented-btn" id="btn-scen-realtime" onclick="switchScenario('realtime')">
                {{ icons.icon('zap', 13) }}
                <span>Realtime &amp; Event-Driven</span>
            </button>
        </div>

        <!-- Glass Actions -->
        <div style="display: flex; align-items: center; gap: 8px;">
            <button type="button" class="apple-glass-btn" id="btn-toggle-traffic" onclick="toggleTraffic()" title="Pausar o reanudar paquetes de tráfico">
                {{ icons.icon('play', 12) }}
                <span id="txt-traffic-btn">Pausar Flujo</span>
            </button>
            <button type="button" class="apple-glass-btn" id="btn-chaos-mode" onclick="toggleChaosMode()" title="Modo de inyección de fallas">
                <span style="color: var(--apple-amber);">⚡</span>
                <span id="txt-chaos-btn">Modo Caos</span>
            </button>
            <button type="button" class="apple-glass-btn" onclick="exportJsonSpec()" title="Exportar especificación técnica de la arquitectura">
                {{ icons.icon('code', 12) }}
                <span>Exportar JSON</span>
            </button>
        </div>
    </header>

    <!-- Main Studio Split Grid -->
    <div class="sd-main-grid">
        <!-- Interactive Frosted Glass Canvas Stage -->
        <div class="sd-stage-glass">
            <div class="sd-stage-grid"></div>

            <div class="sd-stage-toolbar">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span class="apple-glass-badge badge-info" id="scenarioBadge">ESCENARIO 01</span>
                    <span id="scenarioDescription" style="font-weight: 500; color: #ffffff;">Plataforma E-commerce con pico de tráfico CyberMonday</span>
                </div>
                <div style="display: flex; align-items: center; gap: 14px;">
                    <span id="trafficSpeedLabel" style="font-family: var(--font-mono); color: var(--apple-emerald);">● Tráfico en Vivo: 9,840 req/s</span>
                    <span style="color: rgba(255,255,255,0.4);">|</span>
                    <span style="font-size: 11px; color: rgba(255,255,255,0.6);">Haz clic en un nodo para inspeccionarlo</span>
                </div>
            </div>

            <div class="sd-canvas-viewport" id="canvasViewport">
                <!-- SVG Stream Network with Animated Glow Particles -->
                <svg id="networkSvg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="grad-blue" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#0a84ff" stop-opacity="0.8"/>
                            <stop offset="100%" stop-color="#64d2ff" stop-opacity="0.8"/>
                        </linearGradient>
                        <linearGradient id="grad-green" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#30d158" stop-opacity="0.8"/>
                            <stop offset="100%" stop-color="#63e6be" stop-opacity="0.8"/>
                        </linearGradient>
                        <linearGradient id="grad-purple" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#bf5af2" stop-opacity="0.8"/>
                            <stop offset="100%" stop-color="#ff375f" stop-opacity="0.8"/>
                        </linearGradient>
                        <linearGradient id="grad-amber" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#ff9f0a" stop-opacity="0.8"/>
                            <stop offset="100%" stop-color="#ffd60a" stop-opacity="0.8"/>
                        </linearGradient>

                        <filter id="glow-particle" x="-50%" y="-50%" width="200%" height="200%">
                            <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="blur"/>
                            <feMerge>
                                <feMergeNode in="blur"/>
                                <feMergeNode in="SourceGraphic"/>
                            </feMerge>
                        </filter>
                    </defs>

                    <g id="svgPathsGroup"></g>
                    <g id="svgParticlesGroup"></g>
                </svg>

                <!-- Dynamic Architectural Nodes (Rendered by JS) -->
                <div id="nodesContainer"></div>
            </div>
        </div>

        <!-- Apple Minimalist Glass Inspector Sheet -->
        <aside class="sd-inspector-glass">
            <div class="sd-inspector-header">
                <div class="sd-inspector-title">
                    {{ icons.icon('sliders', 14) }}
                    <span>Inspector de Nodo</span>
                </div>
                <div id="inspectorHealthBadge" class="apple-glass-badge badge-success">
                    <span class="sd-pulse-dot"></span>
                    <span id="inspectorHealthText">OPERACIONAL</span>
                </div>
            </div>

            <div class="sd-inspector-body">
                <!-- Node Identity -->
                <div>
                    <span class="apple-glass-badge" id="inspTag" style="font-size: 10px; margin-bottom: 8px;">EDGE / ANYCAST</span>
                    <h2 style="font-size: 18px; font-weight: 700; color: #ffffff; letter-spacing: -0.02em; margin: 0 0 4px 0;" id="inspTitle">Browser / Mobile Client</h2>
                    <div style="font-size: 11.5px; color: var(--apple-blue-light); font-family: var(--font-mono);" id="inspProtocol">Protocolo: HTTP/3 (QUIC) &bull; TLS 1.3</div>
                </div>

                <!-- Apple Watch Telemetry Glass Rings -->
                <div class="sd-telemetry-grid">
                    <div class="sd-metric-box">
                        <div class="sd-ring-wrap">
                            <svg viewBox="0 0 36 36">
                                <path class="sd-ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                <path class="sd-ring-bar" id="ringLatency" stroke="var(--apple-blue)" stroke-dasharray="100, 100" stroke-dashoffset="35" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                            </svg>
                        </div>
                        <div>
                            <div class="sd-metric-val" id="metricLatency">1.2 ms</div>
                            <div class="sd-metric-lbl">Latencia p95</div>
                        </div>
                    </div>

                    <div class="sd-metric-box">
                        <div class="sd-ring-wrap">
                            <svg viewBox="0 0 36 36">
                                <path class="sd-ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                <path class="sd-ring-bar" id="ringThroughput" stroke="var(--apple-emerald)" stroke-dasharray="100, 100" stroke-dashoffset="15" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                            </svg>
                        </div>
                        <div>
                            <div class="sd-metric-val" id="metricThroughput">9.8k QPS</div>
                            <div class="sd-metric-lbl">Throughput</div>
                        </div>
                    </div>

                    <div class="sd-metric-box">
                        <div class="sd-ring-wrap">
                            <svg viewBox="0 0 36 36">
                                <path class="sd-ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                <path class="sd-ring-bar" id="ringCache" stroke="var(--apple-purple)" stroke-dasharray="100, 100" stroke-dashoffset="8" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                            </svg>
                        </div>
                        <div>
                            <div class="sd-metric-val" id="metricCache">96.4%</div>
                            <div class="sd-metric-lbl">Cache Hit</div>
                        </div>
                    </div>

                    <div class="sd-metric-box">
                        <div class="sd-ring-wrap">
                            <svg viewBox="0 0 36 36">
                                <path class="sd-ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                <path class="sd-ring-bar" id="ringSla" stroke="var(--apple-cyan)" stroke-dasharray="100, 100" stroke-dashoffset="2" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                            </svg>
                        </div>
                        <div>
                            <div class="sd-metric-val" id="metricSla">99.99%</div>
                            <div class="sd-metric-lbl">SLA Uptime</div>
                        </div>
                    </div>
                </div>

                <!-- Responsibility Card -->
                <div class="apple-glass-card" style="padding: 14px;">
                    <div style="font-size: 11.5px; font-weight: 600; color: rgba(255, 255, 255, 0.9); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                        {{ icons.icon('cpu', 13) }}
                        <span>Responsabilidad Arquitectónica</span>
                    </div>
                    <p id="inspResp" style="font-size: 12px; color: rgba(255, 255, 255, 0.75); line-height: 1.5; margin: 0;">
                        Inicia peticiones web seguras, renderiza la vista y almacena cookies HttpOnly de sesión.
                    </p>
                </div>

                <!-- Bottlenecks & Failure Modes -->
                <div class="apple-glass-card" style="padding: 14px; border-left: 3px solid var(--apple-amber);">
                    <div style="font-size: 11.5px; font-weight: 600; color: var(--apple-amber); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                        <span style="font-size: 13px;">⚠️</span>
                        <span>Cuello de Botella / Modo de Falla</span>
                    </div>
                    <p id="inspBottleneck" style="font-size: 12px; color: rgba(255, 255, 255, 0.8); line-height: 1.5; margin: 0;">
                        Latencia de red del último kilómetro y retransmisión TCP bajo redes móviles deficientes.
                    </p>
                </div>

                <!-- Senior Criteria & Mitigation -->
                <div class="apple-glass-card" style="padding: 14px; border-left: 3px solid var(--apple-emerald);">
                    <div style="font-size: 11.5px; font-weight: 600; color: var(--apple-emerald); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                        {{ icons.icon('shield', 13) }}
                        <span>Criterio Senior &amp; Mitigación</span>
                    </div>
                    <p id="inspSenior" style="font-size: 12px; color: rgba(255, 255, 255, 0.8); line-height: 1.5; margin: 0;">
                        Establecer cabeceras Cache-Control con max-age largo para assets y habilitar DNS prefetching.
                    </p>
                </div>

                <!-- Production Config Code Snippet -->
                <div>
