                    resp: 'Enruta mensajes instantáneos entre diferentes instancias de Mercure Hub sin persistencia innecesaria.',
                    bottleneck: 'Pérdida de mensajes si un suscriptor no está conectado al momento del PUBLISH.',
                    senior: 'Usar Redis Streams en lugar de Pub/Sub estándar para los canales que requieran histórico de eventos.',
                    config: '# Redis Streams XADD\nXADD live_chat * user_id 42 text "Hola equipo!"'
                },
                {
                    id: 'kafka_broker',
                    title: 'Apache Kafka Cluster',
                    desc: 'Partitioned Event Log',
                    tag: 'BUS DE EVENTOS DURADERO',
                    protocol: 'Kafka Binary Protocol (9092)',
                    x: 730, y: 220,
                    icon: 'database',
                    color: 'linear-gradient(135deg, #0a84ff, #bf5af2)',
                    metrics: { latency: '3.5 ms', throughput: '45k ev/s', cache: '0%', sla: '99.999%', r1: 24, r2: 18, r3: 95, r4: 1 },
                    resp: 'Almacena de forma ordenada y distribuida el flujo histórico de billones de eventos.',
                    bottleneck: 'Desbalanceo de particiones por llaves de particionamiento mal distribuidas.',
                    senior: 'Elegir llaves de partición uniformes (ej. Tenant ID o Hash de User ID) para balancear la carga entre brokers.',
                    config: '# Kafka topic creation\nbin/kafka-topics.sh --create --topic app-events \\\n  --partitions 12 --replication-factor 3 \\\n  --bootstrap-server localhost:9092'
                },
                {
                    id: 'scylla_db',
                    title: 'ScyllaDB / Cassandra',
                    desc: 'High-Write Time-Series',
                    tag: 'PERSISTENCIA DISTRIBUIDA',
                    protocol: 'CQL Native Protocol (9042)',
                    x: 480, y: 370,
                    icon: 'sliders',
                    color: 'linear-gradient(135deg, #30d158, #63e6be)',
                    metrics: { latency: '1.8 ms', throughput: '45k w/s', cache: '0%', sla: '99.999%', r1: 18, r2: 12, r3: 95, r4: 1 },
                    resp: 'Almacena telemetría, métricas y mensajes de chat de alta velocidad con escrituras directas en LSM-trees.',
                    bottleneck: 'Hot partitions si un canal muy activo supera el tamaño límite de 100MB por partición.',
                    senior: 'Particionamiento compuesto con ventanas de tiempo (ej. `partition_key = (channel_id, year_month_day)`).',
                    config: '# CQL Table with compound partition key\nCREATE TABLE chat_messages (\n    channel_id UUID,\n    bucket_date DATE,\n    message_id TIMEUUID,\n    content TEXT,\n    PRIMARY KEY ((channel_id, bucket_date), message_id)\n) WITH CLUSTERING ORDER BY (message_id DESC);'
                },
                {
                    id: 'olap_workers',
                    title: 'Analytics Workers',
                    desc: 'ClickHouse / Vector Ingestion',
                    tag: 'BIG DATA / OLAP',
                    protocol: 'Batch Parquet / ClickHouse TCP',
                    x: 730, y: 370,
                    icon: 'cpu',
                    color: 'linear-gradient(135deg, #ff9f0a, #ff375f)',
                    metrics: { latency: '45 ms', throughput: '15k ev/s', cache: '0%', sla: '99.9%', r1: 55, r2: 35, r3: 95, r4: 8 },
                    resp: 'Consume lotes desde Kafka y alimenta almacenes analíticos columnares para dashboards en tiempo real.',
                    bottleneck: 'Saturación de I/O en disco por escrituras fila por fila.',
                    senior: 'Bufferizado en memoria e inserción masiva en micro-batches de 5,000 registros para maximizar compresión de ClickHouse.',
                    config: '# ClickHouse Batch insert\nINSERT INTO events_buffer VALUES (...5000 rows...);'
                }
            ],
            connections: [
                { from: 'ws_clients', to: 'edge_gw', color: 'url(#grad-blue)', type: 'http' },
                { from: 'edge_gw', to: 'mercure_hub', color: 'url(#grad-blue)', type: 'http' },
                { from: 'mercure_hub', to: 'event_dispatcher', color: 'url(#grad-blue)', type: 'http' },
                { from: 'event_dispatcher', to: 'redis_pubsub', color: 'url(#grad-green)', type: 'cache' },
                { from: 'event_dispatcher', to: 'kafka_broker', color: 'url(#grad-purple)', type: 'async' },
                { from: 'kafka_broker', to: 'scylla_db', color: 'url(#grad-amber)', type: 'sql' },
                { from: 'kafka_broker', to: 'olap_workers', color: 'url(#grad-purple)', type: 'async' }
            ]
        }
    };

    let currentScenarioKey = 'ecommerce';
    let selectedNodeId = 'client';
    let isTrafficActive = true;
    let isChaosActive = false;
    let degradedNodes = new Set();
    let trafficInterval = null;

    function initStudio() {
        renderCurrentScenario();
        startTrafficAnimation();
    }

    function switchScenario(key) {
        if (!SCENARIOS[key]) return;
        currentScenarioKey = key;
        degradedNodes.clear();

        document.querySelectorAll('.apple-segmented-btn').forEach(btn => btn.classList.remove('is-active'));
        const activeBtn = document.getElementById(`btn-scen-${key}`);
        if (activeBtn) activeBtn.classList.add('is-active');

        const scen = SCENARIOS[key];
        document.getElementById('scenarioDescription').innerText = scen.desc;
        document.getElementById('trafficSpeedLabel').innerText = `● Tráfico en Vivo: ${scen.qps}`;

        const badge = document.getElementById('scenarioBadge');
        if (key === 'ecommerce') badge.innerText = 'ESCENARIO 01 (E-COMMERCE)';
        if (key === 'fintech') badge.innerText = 'ESCENARIO 02 (FINTECH / PCI)';
        if (key === 'realtime') badge.innerText = 'ESCENARIO 03 (STREAMING)';

        selectedNodeId = scen.nodes[0].id;
        renderCurrentScenario();
    }

    function renderCurrentScenario() {
        const scen = SCENARIOS[currentScenarioKey];
        const container = document.getElementById('nodesContainer');
        container.innerHTML = '';

        // Render Nodes
        scen.nodes.forEach(node => {
            const el = document.createElement('div');
            el.className = `sd-node ${node.id === selectedNodeId ? 'is-selected' : ''}`;
            if (degradedNodes.has(node.id)) {
                el.classList.add('is-degraded');
            }
            el.id = `node-${node.id}`;
            el.style.left = `${node.x}px`;
            el.style.top = `${node.y}px`;
            el.onclick = () => onNodeClick(node.id);

            el.innerHTML = `
                <div class="sd-node-header">
                    <div class="sd-node-squircle" style="background: ${node.color};">
                        ${getIconSvg(node.icon)}
                    </div>
                    <div>
                        <div class="sd-node-title">${node.title}</div>
                        <div class="sd-node-desc">${node.desc}</div>
                    </div>
                </div>
                <div class="sd-node-footer">
                    <div class="sd-node-beacon">
                        <span class="sd-pulse-dot" style="${degradedNodes.has(node.id) ? 'background-color: var(--apple-amber); box-shadow: 0 0 8px var(--apple-amber);' : ''}"></span>
                        <span style="color: ${degradedNodes.has(node.id) ? 'var(--apple-amber)' : 'var(--apple-emerald)'}; font-weight: 600;">
                            ${degradedNodes.has(node.id) ? 'DEGRADADO' : 'OPERATIVO'}
                        </span>
                    </div>
                    <span style="color: rgba(255,255,255,0.6); font-family: var(--font-mono);">${node.metrics.latency}</span>
                </div>
            `;
            container.appendChild(el);
        });

        // Render SVG Connectors with smooth Bezier Splines
        renderSvgConnections();
        updateInspector(selectedNodeId);
    }

    function renderSvgConnections() {
        const scen = SCENARIOS[currentScenarioKey];
        const pathsGroup = document.getElementById('svgPathsGroup');
        pathsGroup.innerHTML = '';

        scen.connections.forEach((conn, index) => {
            const fromNode = scen.nodes.find(n => n.id === conn.from);
            const toNode = scen.nodes.find(n => n.id === conn.to);
            if (!fromNode || !toNode) return;

            // Compute center anchors
            const x1 = fromNode.x + 90;
            const y1 = fromNode.y + 40;
            const x2 = toNode.x + 90;
            const y2 = toNode.y + 40;

            // Generate Apple Bezier Spline
            const dx = Math.abs(x2 - x1) * 0.5;
            const dy = Math.abs(y2 - y1) * 0.5;
            const cx1 = x1 + (x2 > x1 ? dx : -dx);
            const cy1 = y1;
            const cx2 = x2 - (x2 > x1 ? dx : -dx);
            const cy2 = y2;

            const pathData = `M ${x1} ${y1} C ${cx1} ${cy1}, ${cx2} ${cy2}, ${x2} ${y2}`;

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', pathData);
            path.setAttribute('id', `conn-${conn.from}-${conn.to}`);
            path.setAttribute('stroke', conn.color);
            path.setAttribute('stroke-width', '2');
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke-linecap', 'round');
            path.setAttribute('stroke-dasharray', '6 4');
            path.setAttribute('class', 'flow-line');
            path.style.opacity = '0.7';

            pathsGroup.appendChild(path);
        });
    }

    function startTrafficAnimation() {
        if (trafficInterval) clearInterval(trafficInterval);
        const particlesGroup = document.getElementById('svgParticlesGroup');
        particlesGroup.innerHTML = '';

        trafficInterval = setInterval(() => {
            if (!isTrafficActive) return;
            spawnTrafficPulse();
        }, 320);
    }

    function spawnTrafficPulse() {
        const scen = SCENARIOS[currentScenarioKey];
        const particlesGroup = document.getElementById('svgParticlesGroup');
        if (!particlesGroup) return;

        // Select a random connection to send a luminous pulse
        const conn = scen.connections[Math.floor(Math.random() * scen.connections.length)];
        const pathEl = document.getElementById(`conn-${conn.from}-${conn.to}`);
        if (!pathEl) return;

        const pathLength = pathEl.getTotalLength();
        if (!pathLength) return;

        const particle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        particle.setAttribute('r', '4');
        particle.setAttribute('fill', '#ffffff');
        particle.setAttribute('class', 'packet-particle');
        particle.style.opacity = '0.9';

        particlesGroup.appendChild(particle);

        let startTime = performance.now();
        const duration = 1200 + Math.random() * 400;

        function animate(now) {
            const elapsed = now - startTime;
            const progress = elapsed / duration;

            if (progress >= 1) {
                if (particle.parentNode) particle.parentNode.removeChild(particle);
                return;
            }

            const point = pathEl.getPointAtLength(progress * pathLength);
            particle.setAttribute('cx', point.x);
            particle.setAttribute('cy', point.y);

            requestAnimationFrame(animate);
        }

        requestAnimationFrame(animate);
    }

    function toggleTraffic() {
        isTrafficActive = !isTrafficActive;
        const btn = document.getElementById('txt-traffic-btn');
        btn.innerText = isTrafficActive ? 'Pausar Flujo' : 'Reanudar Flujo';
    }

    function toggleChaosMode() {
        isChaosActive = !isChaosActive;
        const btn = document.getElementById('btn-chaos-mode');
        const txt = document.getElementById('txt-chaos-btn');

        if (isChaosActive) {
            btn.classList.add('btn-primary');
            txt.innerText = 'Caos Activo (Haz clic en un nodo)';
        } else {
            btn.classList.remove('btn-primary');
            txt.innerText = 'Modo Caos';
        }
    }

    function onNodeClick(id) {
        if (isChaosActive) {
            toggleNodeDegradation(id);
        } else {
            selectNode(id);
        }
    }

    function selectNode(id) {
        selectedNodeId = id;
        document.querySelectorAll('.sd-node').forEach(el => el.classList.remove('is-selected'));
        const nodeEl = document.getElementById(`node-${id}`);
        if (nodeEl) nodeEl.classList.add('is-selected');

        updateInspector(id);
    }

    function toggleNodeDegradation(id) {
        if (degradedNodes.has(id)) {
            degradedNodes.delete(id);
        } else {
            degradedNodes.add(id);
        }
        renderCurrentScenario();
    }

    function triggerFaultForCurrentNode() {
        toggleNodeDegradation(selectedNodeId);
    }

    function updateInspector(id) {
        const scen = SCENARIOS[currentScenarioKey];
        const node = scen.nodes.find(n => n.id === id);
        if (!node) return;

        document.getElementById('inspTag').innerText = node.tag;
        document.getElementById('inspTitle').innerText = node.title;
        document.getElementById('inspProtocol').innerText = `Protocolo: ${node.protocol}`;
        document.getElementById('inspResp').innerText = node.resp;
        document.getElementById('inspBottleneck').innerText = node.bottleneck;
        document.getElementById('inspSenior').innerText = node.senior;
        document.getElementById('inspConfigCode').innerText = node.config;

        const isDegraded = degradedNodes.has(id);
        const healthBadge = document.getElementById('inspectorHealthBadge');
        const healthText = document.getElementById('inspectorHealthText');

        if (isDegraded) {
            healthBadge.className = 'apple-glass-badge badge-warning';
            healthText.innerText = 'DEGRADADO (FAILOVER ACTIVO)';
            document.getElementById('metricLatency').innerText = '148 ms';
            document.getElementById('ringLatency').style.stroke = 'var(--apple-amber)';
            document.getElementById('ringLatency').style.strokeDashoffset = '70';
        } else {
            healthBadge.className = 'apple-glass-badge badge-success';
            healthText.innerText = 'OPERACIONAL';
            document.getElementById('metricLatency').innerText = node.metrics.latency;
            document.getElementById('ringLatency').style.stroke = 'var(--apple-blue)';
            document.getElementById('ringLatency').style.strokeDashoffset = node.metrics.r1;
        }

        document.getElementById('metricThroughput').innerText = node.metrics.throughput;
        document.getElementById('metricCache').innerText = node.metrics.cache;
        document.getElementById('metricSla').innerText = node.metrics.sla;

        document.getElementById('ringThroughput').style.strokeDashoffset = node.metrics.r2;
        document.getElementById('ringCache').style.strokeDashoffset = node.metrics.r3;
        document.getElementById('ringSla').style.strokeDashoffset = node.metrics.r4;
    }

    function exportJsonSpec() {
        const scen = SCENARIOS[currentScenarioKey];
        const payload = {
            studio: "Senior DevLab System Design Studio - Apple Glass Edition",
            scenario_key: currentScenarioKey,
            scenario_title: scen.title,
            qps_target: scen.qps,
            exported_at: new Date().toISOString(),
            nodes: scen.nodes.map(n => ({
                id: n.id,
                title: n.title,
                tag: n.tag,
                protocol: n.protocol,
                status: degradedNodes.has(n.id) ? "DEGRADED" : "OPERATIONAL",
                senior_mitigation: n.senior,
                metrics: n.metrics
            })),
            connections: scen.connections
        };

        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `system-design-${currentScenarioKey}-spec.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    function getIconSvg(name) {
        const icons = {
            user: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
            zap: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
            layers: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
            symfony: '<svg width="15" height="15" viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="14" fill="#000" stroke="#fff" stroke-width="1.5"/><path d="M14.5 10C12.5 10 10.5 11.2 10.5 13.5C10.5 18 19 16 19 20C19 22 17 22.8 15 22.8C12.8 22.8 11.5 21.8 10.8 20.8" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>',
            redis: '<svg width="15" height="15" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="6" fill="#DC382D"/><polygon points="16,8 25,13 16,18 7,13" fill="#FFF"/><polygon points="16,14 25,19 16,24 7,19" fill="#FEE2E2"/></svg>',
            mysql: '<svg width="15" height="15" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="6" fill="#00758F"/><path d="M8 21C11 21 13 18 15 14C17 10 20 9 24 10C22 14 19 19 16 22C13 25 10 24 8 21Z" fill="#F29111"/><circle cx="21" cy="13" r="1.5" fill="#FFF"/></svg>',
            database: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>',
            sliders: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="10" y2="3"/><line x1="12" x2="12" y1="21" y2="12"/><line x1="12" x2="12" y1="8" y2="3"/><line x1="20" x2="20" y1="21" y2="16"/><line x1="20" x2="20" y1="12" y2="3"/><line x1="1" x2="7" y1="14" y2="14"/><line x1="9" x2="15" y1="8" y2="8"/><line x1="17" x2="23" y1="16" y2="16"/></svg>',
            cpu: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/></svg>',
            shield: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>',
            award: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/></svg>'
        };
        return icons[name] || icons.cpu;
    }

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', initStudio);
</script>
