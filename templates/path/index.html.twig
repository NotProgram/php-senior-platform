{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Rutas de Aprendizaje Guiadas | Senior DevLab{% endblock %}

{% block body %}
<!-- Header -->
<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span class="user-badge" style="background: rgba(0, 122, 204, 0.15); border-color: rgba(0, 122, 204, 0.4); color: #4fc1ff;">
                {{ icons.icon('compass', 13) }}
                <span>Curriculum Guiado</span>
            </span>
            <span class="user-badge" style="background: rgba(255, 255, 255, 0.05); border-color: var(--border-main); color: var(--text-muted);">
                {{ paths|length }} Rutas Especializadas
            </span>
        </div>
        <h1 class="page-title" style="display: flex; align-items: center; gap: 10px; font-size: 22px; margin-bottom: 6px;">
            {{ icons.icon('git-branch', 22) }}
            <span>Rutas Profesionales de Aprendizaje</span>
        </h1>
        <p class="page-subtitle" style="color: var(--text-muted); font-size: 13px; margin: 0; max-width: 800px;">
            Itinerarios curriculares estructurados con objetivos medibles, criterio de salida por fase y progresi&oacute;n por hitos t&eacute;cnicos.
        </p>
    </div>
</div>

<!-- Focus Path Banner (si existe una ruta activa en progreso) -->
{% if focus %}
<div style="background: #181818; border: 1px solid var(--border-main); border-left: 4px solid {{ focus.accent|default('var(--accent-blue)') }}; border-radius: 6px; padding: 20px 24px; margin-bottom: 28px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span class="user-badge" style="background: rgba(206, 145, 120, 0.15); border-color: rgba(206, 145, 120, 0.4); color: #ce9178; font-size: 11px;">
                {{ icons.icon('activity', 12) }}
                <span>Tu Ruta Prioritaria</span>
            </span>
            <span style="font-size: 11.5px; color: var(--text-muted);">{{ focus.level }}</span>
        </div>
        <a href="{{ path('app_path', {pathSlug: focus.slug}) }}" class="btn-vs" style="font-size: 12px; padding: 5px 14px;">
            <span>Continuar Ruta</span>
            {{ icons.icon('arrow-right', 12) }}
        </a>
    </div>

    <h2 style="font-size: 17px; font-weight: 700; color: #ffffff; margin: 0 0 6px 0;">{{ focus.title }}</h2>
    <p style="color: #cccccc; font-size: 13px; line-height: 1.5; margin: 0 0 16px 0;">{{ focus.subtitle }}</p>

    <!-- Progreso del Focus Path -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 16px; background: #121212; padding: 14px 18px; border-radius: 4px; border: 1px solid var(--border-light);">
        <div>
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 4px;">Progreso General</div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="flex: 1; height: 6px; background: #252526; border-radius: 3px; overflow: hidden;">
                    <div style="width: {{ focus.percent }}%; height: 100%; background: {{ focus.accent|default('var(--accent-blue)') }};"></div>
                </div>
                <span style="font-weight: 700; font-size: 12.5px; color: #ffffff;">{{ focus.percent }}%</span>
            </div>
        </div>
        <div>
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 2px;">Fase Actual</div>
            <div style="font-size: 12.5px; font-weight: 600; color: #9cdcfe;">
                Fase {{ focus.current_phase_number }}: {{ focus.current_phase|default('Completada') }}
            </div>
        </div>
        <div>
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 2px;">Tiempo Estimado Restante</div>
            <div style="font-size: 12.5px; font-weight: 600; color: #d4d4d4;">
                ~{{ focus.hours_left }} h (de {{ focus.hours_total }} h)
            </div>
        </div>
    </div>

    {% if focus.next %}
    <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(0, 122, 204, 0.08); border: 1px solid rgba(0, 122, 204, 0.25); border-radius: 4px; padding: 10px 14px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            {{ icons.icon('play', 14) }}
            <div>
                <span style="font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Siguiente paso recomendado:</span>
                <span style="font-size: 12.5px; font-weight: 600; color: #4fc1ff; margin-left: 6px;">{{ focus.next.title }}</span>
                <span style="font-size: 11px; color: var(--text-muted); margin-left: 8px;">({{ focus.next.minutes }} min)</span>
            </div>
        </div>
        <a href="{{ path('app_lesson', {lessonSlug: focus.next.slug}) }}" class="btn-vs" style="font-size: 11.5px; padding: 4px 10px;">
            <span>Comenzar Lección</span>
        </a>
    </div>
    {% endif %}
</div>
{% endif %}

<!-- Grid de Todas las Rutas -->
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px; margin-bottom: 36px;">
    {% for p in paths %}
    <div style="background: #181818; border: 1px solid var(--border-main); border-radius: 6px; overflow: hidden; display: flex; flex-direction: column; transition: border-color 0.2s;" onmouseenter="this.style.borderColor='var(--accent-blue)'" onmouseleave="this.style.borderColor='var(--border-main)'">
        <!-- Card Top Banner -->
        <div style="height: 4px; background: {{ p.accent|default('var(--accent-blue)') }};"></div>
        
        <div style="padding: 18px 20px; display: flex; flex-direction: column; flex: 1;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                <span class="user-badge" style="background: rgba(255, 255, 255, 0.05); border-color: var(--border-light); color: var(--text-muted); font-size: 10.5px;">
                    {{ p.level }}
                </span>
                <span style="font-size: 11.5px; font-weight: 700; color: {{ p.percent == 100 ? 'var(--accent-success)' : (p.percent > 0 ? '#4fc1ff' : 'var(--text-muted)') }};">
                    {{ p.percent }}% completado
                </span>
            </div>

            <h3 style="font-size: 15px; font-weight: 700; color: #ffffff; margin: 0 0 6px 0;">
                <a href="{{ path('app_path', {pathSlug: p.slug}) }}" style="color: inherit; text-decoration: none;">{{ p.title }}</a>
            </h3>
            <div style="font-size: 12px; color: #9cdcfe; margin-bottom: 10px;">{{ p.subtitle }}</div>
            <p style="font-size: 12px; color: #aaaaaa; line-height: 1.5; margin: 0 0 16px 0; flex: 1;">{{ p.goal }}</p>

            <!-- Barra de Progreso -->
            <div style="height: 4px; background: #252526; border-radius: 2px; overflow: hidden; margin-bottom: 14px;">
                <div style="width: {{ p.percent }}%; height: 100%; background: {{ p.accent|default('var(--accent-blue)') }};"></div>
            </div>

            <!-- Metadatos de la Ruta -->
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; color: var(--text-muted); border-top: 1px solid var(--border-light); padding-top: 12px; margin-bottom: 14px;">
                <span>{{ p.phase_count }} fases &bull; {{ p.total }} lecciones</span>
                <span>~{{ p.hours_total }} horas</span>
            </div>

            <!-- Botón de Acción -->
            <a href="{{ path('app_path', {pathSlug: p.slug}) }}" class="btn-vs btn-vs-secondary" style="width: 100%; justify-content: center; font-size: 12px; padding: 6px 12px;">
                <span>Ver Plan Completo</span>
                {{ icons.icon('arrow-right', 12) }}
            </a>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Prerrequisitos / Siguientes Lecciones Recomendadas -->
{% if recommendations is defined and recommendations|length > 0 %}
<div style="background: #141414; border: 1px solid var(--border-main); border-radius: 6px; padding: 20px 24px;">
    <h2 style="font-size: 15px; font-weight: 700; color: #ffffff; margin: 0 0 14px 0; display: flex; align-items: center; gap: 8px;">
        {{ icons.icon('zap', 15) }}
        <span>Lecciones Recomendadas por Prerrequisitos</span>
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px;">
        {% for rec in recommendations %}
        <div style="background: #1c1c1c; border: 1px solid var(--border-light); border-radius: 4px; padding: 14px; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="font-size: 10.5px; color: #9cdcfe; margin-bottom: 2px;">{{ rec.module|default('Curriculum') }}</div>
                <a href="{{ path('app_lesson', {lessonSlug: rec.slug}) }}" style="font-size: 12.5px; font-weight: 600; color: #ffffff; text-decoration: none;">{{ rec.title }}</a>
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">{{ rec.minutes|default(45) }} min &bull; {{ rec.difficulty|default('Intermedio') }}</div>
            </div>
            <a href="{{ path('app_lesson', {lessonSlug: rec.slug}) }}" class="btn-vs" style="font-size: 11px; padding: 4px 8px; flex-shrink: 0; margin-left: 10px;">
                {{ icons.icon('play', 10) }}
            </a>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}
{% endblock %}
