{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Dashboard | Senior DevLab{% endblock %}

{% block body %}
<!-- Page Header with Telemetry -->
<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
        <h1 class="page-title">
            {{ icons.icon('layout-dashboard', 22) }}
            <span>Dashboard del Desarrollador</span>
        </h1>
        <p class="page-subtitle">
            Telemetr&iacute;a de avance continuo, madurez arquitect&oacute;nica y competencias de nivel Senior.
        </p>
    </div>
    
    <!-- Last Activity Pill -->
    <div style="display: flex; align-items: center; gap: 8px; background: #252526; border: 1px solid var(--border-main); padding: 6px 12px; border-radius: 4px; font-size: 11.5px; color: var(--text-muted);">
        {{ icons.icon('refresh-cw', 13) }}
        <span>{{ metrics.lastActivityText }} &bull; <strong style="color: var(--text-bright);">{{ metrics.lastActivityAgo }}</strong></span>
    </div>
</div>

<!-- Primary Metrics Grid (6 Minimalist Cards) -->
<div class="dashboard-grid">
    
    <!-- 1. Progreso Total -->
    <div class="metric-card">
        <div class="metric-header">
            <span>Progreso Global</span>
            {{ icons.icon('award', 15) }}
        </div>
        <div class="metric-value">{{ metrics.completionPercentage }}%</div>
        <div style="width: 100%; height: 4px; background: #141414; border-radius: 2px; margin: 8px 0; overflow: hidden;">
            <div style="width: {{ metrics.completionPercentage }}%; height: 100%; background: var(--accent-blue);"></div>
        </div>
        <div class="metric-footer">
            <span>{{ metrics.completedLessons }} de {{ metrics.totalLessons }} lecciones dominadas</span>
        </div>
    </div>

    <!-- 2. Nivel Actual -->
    <div class="metric-card">
        <div class="metric-header">
            <span>Nivel Actual</span>
            {{ icons.icon('user', 15) }}
        </div>
        <div class="metric-value" style="color: #4fc1ff;">{{ metrics.currentLevel }}</div>
        <div class="metric-footer">
            <span>Rumbo: Senior Software Engineer</span>
        </div>
    </div>

    <!-- 3. Racha de Aprendizaje -->
    <div class="metric-card">
        <div class="metric-header">
            <span>Racha Activa</span>
            {{ icons.icon('zap', 15) }}
        </div>
        <div class="metric-value" style="color: #89d185;">{{ metrics.streakDays }} d&iacute;a(s)</div>
        <div class="metric-footer">
            <span>H&aacute;bito de desarrollo consistente</span>
        </div>
    </div>

    <!-- 4. Horas Estimadas -->
    <div class="metric-card">
        <div class="metric-header">
            <span>Inversi&oacute;n Estimada</span>
            {{ icons.icon('sliders', 15) }}
        </div>
        <div class="metric-value">{{ metrics.hoursEstimated }}h</div>
        <div class="metric-footer">
            <span>Teor&iacute;a profunda, c&oacute;digo y laboratorios</span>
        </div>
    </div>

    <!-- 5. Módulos Completados -->
    <div class="metric-card">
        <div class="metric-header">
            <span>M&oacute;dulos Completados</span>
            {{ icons.icon('layers', 15) }}
        </div>
        <div class="metric-value">{{ metrics.completedModules }} / {{ metrics.totalModules }}</div>
        <div class="metric-footer">
            <span>Especializaciones t&eacute;cnicas finalizadas</span>
        </div>
    </div>

    <!-- 6. Proyectos Completados -->
    <div class="metric-card">
        <div class="metric-header">
            <span>Proyectos Senior</span>
            {{ icons.icon('terminal', 15) }}
        </div>
        <div class="metric-value" style="color: #ce9178;">{{ metrics.completedProjects }} / {{ metrics.totalProjects }}</div>
        <div class="metric-footer">
            <span>Sistemas reales implementados</span>
        </div>
    </div>

</div>

<!-- Resume Target & Active Lesson Banner -->
<div style="background: #181818; border: 1px solid var(--border-main); border-radius: 6px; padding: 18px 22px; margin-bottom: 28px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
        <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--accent-yellow); font-weight: 700; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            {{ icons.icon('play', 12) }}
            <span>LECCI&Oacute;N EN CURSO &bull; {{ metrics.currentLessonModule }}</span>
        </div>
        <h2 style="font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 4px;">{{ metrics.currentLessonTitle }}</h2>
        <div style="font-size: 12px; color: var(--text-muted);">Pr&oacute;ximo objetivo: {{ metrics.nextTarget }}</div>
    </div>
    <div>
        <a href="{{ path('app_lesson', {lessonSlug: metrics.currentLessonSlug}) }}" class="btn-vs">
            {{ icons.icon('play', 14) }}
            <span>Continuar Lecci&oacute;n</span>
        </a>
    </div>
</div>

<!-- Unlocked Skills Matrix (Competencias Profesionales) -->
<div style="margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
        <h2 style="font-size: 15px; font-weight: 600; color: #ffffff; display: flex; align-items: center; gap: 8px;">
            {{ icons.icon('award', 16) }}
            <span>Habilidades T&eacute;cnicas &amp; Radar de Competencias Senior</span>
        </h2>
        <span style="font-size: 11.5px; color: var(--text-muted);">Desbloqueo basado en dominio pr&aacute;ctico</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;">
        {% for skill in metrics.skills %}
            <div style="background: #252526; border: 1px solid {{ skill.isUnlocked ? 'rgba(137, 209, 133, 0.3)' : 'var(--border-light)' }}; border-radius: 5px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); font-weight: 600;">{{ skill.category }}</span>
                        {% if skill.isUnlocked %}
                            <span style="font-size: 10.5px; color: var(--accent-success); display: flex; align-items: center; gap: 4px; font-weight: 600;">
                                {{ icons.icon('check-circle', 12) }}
                                <span>Desbloqueada</span>
                            </span>
                        {% else %}
                            <span style="font-size: 10.5px; color: var(--text-muted); display: flex; align-items: center; gap: 4px;">
                                {{ icons.icon('circle', 11) }}
                                <span>Bloqueada</span>
                            </span>
                        {% endif %}
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                        {{ icons.icon(skill.icon, 16) }}
                        <h3 style="font-size: 13px; font-weight: 600; color: {{ skill.isUnlocked ? '#ffffff' : '#858585' }};">{{ skill.name }}</h3>
                    </div>
                    <p style="font-size: 11.5px; color: #a0a0a0; line-height: 1.5;">{{ skill.description }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Senior Philosophy Callout -->
<div class="senior-thinking-callout">
    <div class="senior-thinking-title">
        {{ icons.icon('cpu', 18) }}
        <span>El Proceso Mental del Desarrollador Senior</span>
    </div>
    <p style="color: #d4d4d4; font-size: 13px; line-height: 1.7; margin-bottom: 10px;">
        Un desarrollador Junior se enfoca en que el c&oacute;digo funcione para el caso feliz (*Happy Path*). Un desarrollador Senior eval&uacute;a:
    </p>
    <ul style="margin-left: 20px; color: #d4d4d4; font-size: 12.5px; line-height: 1.7;">
        <li>&iquest;Qu&eacute; ocurre si la base de datos se satura o la conexi&oacute;n cae durante una transacci&oacute;n?</li>
        <li>&iquest;Cu&aacute;l es el costo de mantenimiento cognitivo para otro desarrollador dentro de 6 meses?</li>
        <li>&iquest;Estamos agregando una abstracci&oacute;n prematura que no resuelve ning&uacute;n problema de negocio real hoy?</li>
    </ul>
</div>
{% endblock %}
