{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Configuración | Senior DevLab{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">
        {{ icons.icon('settings', 22) }}
        <span>Configuración de la Plataforma</span>
    </h1>
    <p class="page-subtitle">
        Parámetros del entorno de aprendizaje, perfil del estudiante y sincronización de progreso.
    </p>
</div>

<div style="max-width: 760px; display: flex; flex-direction: column; gap: 20px;">
    <!-- Backup / Restore Section -->
    <div class="metric-card" style="padding: 20px; border-left: 3px solid var(--accent-cyan);">
        <h2 style="font-size: 15px; font-weight: 600; color: #ffffff; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
            {{ icons.icon('refresh-cw', 16) }}
            <span>Sincronización y Respaldo de Progreso (JSON)</span>
        </h2>
        <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 18px; line-height: 1.5;">
            Dado que estudias de manera individual y local, puedes exportar tu progreso al finalizar cada lección o sesión de estudio en un archivo snapshot <code>.json</code> e importarlo cuando vuelvas para reanudar exactamente tus lecciones completadas, códigos de reto, evaluaciones y repasos espaciados.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-bottom: 18px;">
            <!-- Export Card -->
            <div style="background: var(--bg-deep); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 16px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px;">
                <div>
                    <div style="font-weight: 600; color: var(--accent-cyan); font-size: 13.5px; display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
                        {{ icons.icon('download', 15) }}
                        <span>Exportar Progreso</span>
                    </div>
                    <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                        Descarga un archivo JSON snapshot con tus lecciones completadas, puntajes, intentos de código y tarjetas de memoria.
                    </p>
                </div>
                <a href="{{ path('app_export_progress') }}" class="btn-vs" style="background: var(--wash-cyan); border: 1px solid rgba(86, 212, 255, 0.4); color: var(--accent-cyan); text-decoration: none; justify-content: center; font-weight: 600;">
                    {{ icons.icon('download', 14) }}
                    <span>Descargar Backup JSON</span>
                </a>
            </div>

            <!-- Import Card -->
            <div style="background: var(--bg-deep); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 16px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px;">
                <div>
                    <div style="font-weight: 600; color: var(--accent-success); font-size: 13.5px; display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
                        {{ icons.icon('upload', 15) }}
                        <span>Importar Progreso</span>
                    </div>
                    <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                        Sube tu archivo JSON descargado previamente para restaurar tu estado de aprendizaje en esta sesión.
                    </p>
                </div>
                <form action="{{ path('app_import_progress') }}" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 8px;">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                    <input type="file" name="backup_file" accept=".json,application/json" required style="font-size: 11.5px; color: var(--text-soft); background: var(--bg-surface); padding: 6px; border: 1px dashed var(--border-light); border-radius: var(--radius-sm); cursor: pointer;">
                    <button type="submit" class="btn-vs" style="background: var(--wash-success); border: 1px solid rgba(110, 222, 138, 0.4); color: var(--accent-success); justify-content: center; font-weight: 600;">
                        {{ icons.icon('upload', 14) }}
                        <span>Restaurar desde JSON</span>
                    </button>
                </form>
            </div>
        </div>

        {% if auto_backup_info %}
            <div style="background: rgba(108, 124, 255, 0.08); border: 1px solid rgba(108, 124, 255, 0.25); border-radius: var(--radius-md); padding: 14px; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;">
                <div>
                    <div style="font-size: 12.5px; font-weight: 600; color: var(--accent-primary-hi); display: flex; align-items: center; gap: 6px;">
                        {{ icons.icon('shield', 14) }}
                        <span>Autoguardado local detectado en <code>var/progress_backup.json</code></span>
                    </div>
                    <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 3px;">
                        {{ auto_backup_info.lessons_count }} lección(es) registradas &bull; {{ auto_backup_info.xp }} XP &bull; Actualizado: {{ auto_backup_info.updated_at|date('Y-m-d H:i') }}
                    </div>
                </div>
                <form action="{{ path('app_import_auto_backup') }}" method="POST" onsubmit="return confirm('¿Deseas restaurar el progreso desde la última copia automática local?');">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                    <button type="submit" class="btn-vs" style="background: var(--wash-primary); border: 1px solid rgba(108, 124, 255, 0.4); color: var(--accent-primary-hi); font-size: 11.5px; font-weight: 600;">
                        {{ icons.icon('refresh-cw', 12) }}
                        <span>Restaurar Autoguardado</span>
                    </button>
                </form>
            </div>
        {% endif %}
    </div>

    <!-- Developer Profile Card -->
    <div class="metric-card" style="padding: 20px;">
        <h2 style="font-size: 15px; font-weight: 600; color: #ffffff; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            {{ icons.icon('user', 16) }}
            <span>Perfil del Desarrollador</span>
        </h2>
        <div class="settings-grid settings-profile-grid" style="display: grid; grid-template-columns: 140px 1fr; gap: 12px; font-size: 13px; margin-bottom: 14px; align-items: center;">
            <span style="color: #858585;">Nombre:</span>
            <div>
                <form action="{{ path('app_settings_update_profile') }}" method="POST" style="display: flex; gap: 8px; align-items: center; max-width: 380px;">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                    <input type="text" 
                           name="display_name" 
                           value="{{ current_user.displayName }}" 
                           required 
                           maxlength="100" 
                           style="background: var(--bg-surface); border: 1px solid var(--border-main); color: var(--text-bright); padding: 5px 10px; border-radius: var(--radius-sm); font-size: 13px; flex: 1; outline: none;" 
                           placeholder="Tu nombre o alias">
                    <button type="submit" class="btn-vs" style="background: var(--wash-primary); border: 1px solid rgba(108, 124, 255, 0.4); color: var(--accent-primary-hi); font-size: 11.5px; font-weight: 600; white-space: nowrap;">
                        {{ icons.icon('check', 13) }}
                        <span>Guardar</span>
                    </button>
                </form>
            </div>

            <span style="color: #858585;">Email:</span>
            <span style="color: #ffffff;">{{ current_user.email }}</span>

            <span style="color: #858585;">Nivel Actual:</span>
            <span style="color: #4fc1ff; font-weight: 600;">{{ current_user.currentLevel }}</span>

            <span style="color: #858585;">Experiencia (XP):</span>
            <span style="color: #89d185; font-weight: 600;">{{ current_user.experiencePoints }} XP</span>

            <span style="color: #858585;">Racha:</span>
            <span style="color: #89d185;">{{ current_user.streakDays }} día(s) consecutivo(s)</span>
        </div>

        <div style="border-top: 1px solid var(--border-light); padding-top: 14px;">
            <form action="{{ path('app_settings_reset_progress') }}" method="POST" onsubmit="return confirm('¿Seguro que deseas reiniciar tu progreso a cero? Se borrarán todos los intentos de ejercicios y quizzes.');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button type="submit" class="btn-vs" style="background: rgba(241, 76, 76, 0.2); border: 1px solid rgba(241, 76, 76, 0.5); color: #f14c4c; font-size: 11.5px;">
                    {{ icons.icon('refresh-cw', 12) }}
                    <span>Reiniciar mi progreso a cero</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Telemetry Card -->
    <div class="metric-card" style="padding: 20px;">
        <h2 style="font-size: 15px; font-weight: 600; color: #ffffff; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            {{ icons.icon('cpu', 16) }}
            <span>Telemetría del Entorno Local</span>
        </h2>
        <div class="settings-grid settings-telemetry-grid" style="display: grid; grid-template-columns: 180px 1fr; gap: 10px; font-size: 13px;">
            <span style="color: #858585;">PHP Runtime:</span>
            <span style="color: #ffffff;">PHP {{ constant('PHP_VERSION') }} ({{ constant('PHP_OS_FAMILY') }})</span>

            <span style="color: #858585;">Framework:</span>
            <span style="color: #ffffff;">Symfony {{ constant('Symfony\\Component\\HttpKernel\\Kernel::VERSION') }}</span>

            <span style="color: #858585;">Motor de Base de Datos:</span>
            <span style="color: #ffffff;">MySQL 8.0 Community Server (127.0.0.1:3306)</span>

            <span style="color: #858585;">ORM &amp; Mapeo:</span>
            <span style="color: #ffffff;">Doctrine ORM 3.x (Unit of Work activo)</span>

            <span style="color: #858585;">Plantillas:</span>
            <span style="color: #ffffff;">Twig 3.x (Compilación nativa en caché)</span>
        </div>
    </div>
</div>
{% endblock %}
