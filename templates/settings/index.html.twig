{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Configuración | Senior DevLab{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">
        {{ icons.icon('settings', 22) }}
        <span>Configuración de la Plataforma</span>
    </h1>
    <p class="page-subtitle">
        Parámetros del entorno de aprendizaje, perfil del estudiante y estado del runtime.
    </p>
</div>

<div style="max-width: 700px; display: flex; flex-direction: column; gap: 20px;">
    <div class="metric-card" style="padding: 20px;">
        <h2 style="font-size: 15px; font-weight: 600; color: #ffffff; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            {{ icons.icon('user', 16) }}
            <span>Perfil del Desarrollador</span>
        </h2>
        <div style="display: grid; grid-template-columns: 140px 1fr; gap: 10px; font-size: 13px; margin-bottom: 14px;">
            <span style="color: #858585;">Nombre:</span>
            <span style="color: #ffffff; font-weight: 500;">{{ current_user.displayName }}</span>

            <span style="color: #858585;">Email:</span>
            <span style="color: #ffffff;">{{ current_user.email }}</span>

            <span style="color: #858585;">Nivel Actual:</span>
            <span style="color: #4fc1ff; font-weight: 600;">{{ current_user.currentLevel }}</span>

            <span style="color: #858585;">Experiencia (XP):</span>
            <span style="color: #89d185; font-weight: 600;">{{ current_user.experiencePoints }} XP</span>

            <span style="color: #858585;">Racha:</span>
            <span style="color: #89d185;">{{ current_user.streakDays }} día(s) consecutivo(s)</span>
        </div>

        <div style="border-top: 1px solid var(--border-light); padding-top: 14px;">
            <form action="{{ path('app_settings_reset_progress') }}" method="POST" onsubmit="return confirm('¿Seguro que deseas reiniciar tu progreso a cero? Se borrarán todos los intentos de ejercicios y quizzes.');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button type="submit" class="btn-vs" style="background: rgba(241, 76, 76, 0.2); border: 1px solid rgba(241, 76, 76, 0.5); color: #f14c4c; font-size: 11.5px;">
                    {{ icons.icon('refresh-cw', 12) }}
                    <span>Reiniciar mi progreso a cero</span>
                </button>
            </form>
        </div>
    </div>

    <div class="metric-card" style="padding: 20px;">
        <h2 style="font-size: 15px; font-weight: 600; color: #ffffff; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            {{ icons.icon('cpu', 16) }}
            <span>Telemetría del Entorno Local</span>
        </h2>
        <div style="display: grid; grid-template-columns: 180px 1fr; gap: 10px; font-size: 13px;">
            <span style="color: #858585;">PHP Runtime:</span>
            <span style="color: #ffffff;">PHP {{ constant('PHP_VERSION') }} ({{ constant('PHP_OS_FAMILY') }})</span>

            <span style="color: #858585;">Framework:</span>
            <span style="color: #ffffff;">Symfony {{ constant('Symfony\\Component\\HttpKernel\\Kernel::VERSION') }}</span>

            <span style="color: #858585;">Motor de Base de Datos:</span>
            <span style="color: #ffffff;">MySQL 8.0 Community Server (127.0.0.1:3306)</span>

            <span style="color: #858585;">ORM &amp; Mapeo:</span>
            <span style="color: #ffffff;">Doctrine ORM 3.x (Unit of Work activo)</span>

            <span style="color: #858585;">Plantillas:</span>
            <span style="color: #ffffff;">Twig 3.x (Compilación nativa en caché)</span>
        </div>
    </div>
</div>
{% endblock %}
