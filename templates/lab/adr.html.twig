{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Architecture Decision Records (ADR) Studio | Senior DevLab{% endblock %}

{% block stylesheets %}
<style>
    .adr-workspace {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        min-height: calc(100vh - 160px);
    }
    .adr-editor-panel, .adr-preview-panel {
        background: #181818;
        border: 1px solid var(--border-main);
        border-radius: 6px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        overflow-y: auto;
    }
    .preset-selector {
        background: #252526;
        border: 1px solid var(--border-main);
        border-radius: 4px;
        padding: 8px 12px;
        color: #d4d4d4;
        font-family: inherit;
        font-size: 13px;
        width: 100%;
    }
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .form-group label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: #9cdcfe;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .adr-input, .adr-textarea, .adr-select {
        background: #1e1e1e;
        border: 1px solid var(--border-main);
        border-radius: 4px;
        padding: 8px 12px;
        color: #cccccc;
        font-family: var(--font-mono);
        font-size: 12.5px;
        width: 100%;
        box-sizing: border-box;
    }
    .adr-input:focus, .adr-textarea:focus, .adr-select:focus {
        border-color: var(--accent-blue);
        outline: none;
    }
    .adr-textarea {
        resize: vertical;
        min-height: 80px;
        line-height: 1.5;
    }
    .rubric-card {
        background: #202020;
        border: 1px solid var(--border-main);
        border-radius: 6px;
        padding: 14px;
    }
    .metric-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        font-size: 12px;
    }
    .metric-row:last-child {
        border-bottom: none;
    }
    .metric-score {
        font-family: var(--font-mono);
        font-weight: 700;
        color: var(--accent-blue);
    }
    .markdown-rendered {
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 14px;
        padding: 18px;
        font-family: var(--font-mono);
        font-size: 12px;
        color: #d4d4d4;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
        flex: 1;
        overflow-y: auto;
    }
    .status-badge-accepted {
        background: rgba(137, 209, 133, 0.15);
        color: #89d185;
        border: 1px solid #89d185;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 11px;
        font-weight: 700;
    }
    .status-badge-proposed {
        background: rgba(220, 220, 170, 0.15);
        color: #dcdcaa;
        border: 1px solid #dcdcaa;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 11px;
        font-weight: 700;
    }
    .status-badge-deprecated {
        background: rgba(241, 76, 76, 0.15);
        color: #f14c4c;
        border: 1px solid #f14c4c;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 11px;
        font-weight: 700;
    }
</style>
{% endblock %}

{% block body %}
<div style="width: 100%; max-width: 1500px; margin: 0 auto;">
    <!-- Lab Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--border-main);">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                <span style="color: var(--accent-blue);">{{ icons.icon('file-text', 24) }}</span>
                <h1 style="font-size: 20px; font-weight: 700; margin: 0; color: #fff;">Architecture Decision Record (ADR) Studio</h1>
                <span style="font-size: 11px; font-family: var(--font-mono); background: #252526; padding: 2px 8px; border-radius: 3px; color: #858585;">MADR 3.0 / Nygard Standard</span>
            </div>
            <p style="font-size: 13px; color: #858585; margin: 0; max-width: 850px;">
                Draft, evaluate and document immutable architectural choices. Every non-trivial architectural trade-off requires documenting the problem context, considered alternatives, rationale, and operational consequences.
            </p>
        </div>
        <div style="display: flex; gap: 10px;">
            <button onclick="copyMarkdown()" class="btn btn-secondary" style="font-size: 12px; display: flex; align-items: center; gap: 6px;">
                {{ icons.icon('copy', 14) }} Copy Markdown
            </button>
            <button onclick="downloadAdr()" class="btn btn-primary" style="font-size: 12px; display: flex; align-items: center; gap: 6px;">
                {{ icons.icon('download', 14) }} Export .md
            </button>
        </div>
    </div>

    <!-- Presets Bar -->
    <div style="margin-bottom: 20px; background: #1f1f1f; padding: 12px 16px; border: 1px solid var(--border-main); border-radius: 6px; display: flex; align-items: center; gap: 16px;">
        <span style="font-size: 12px; font-weight: 600; color: #9cdcfe; display: flex; align-items: center; gap: 6px;">
            {{ icons.icon('layers', 14) }} Architectural Scenarios:
        </span>
        <select id="presetSelector" class="preset-selector" onchange="loadPreset(this.value)" style="max-width: 550px;">
            <option value="adr-001">ADR-001: PostgreSQL with JSONB vs MongoDB for Domain Audit Events</option>
            <option value="adr-002">ADR-002: Modular Monolith with Symfony Bundles vs Distributed Microservices</option>
            <option value="adr-003">ADR-003: Symfony Messenger with RabbitMQ for Asynchronous Course Ingestion</option>
            <option value="custom">Draft New Custom Architecture Decision Record</option>
        </select>
        <span id="adrStatusTag" class="status-badge-accepted">ACCEPTED</span>
    </div>

    <!-- Workspace Grid -->
    <div class="adr-workspace">
        <!-- Left: Form Controls -->
        <div class="adr-editor-panel">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h2 style="font-size: 14px; font-weight: 700; margin: 0; color: #fff; display: flex; align-items: center; gap: 8px;">
                    {{ icons.icon('edit', 14) }} ADR Specification Fields
                </h2>
                <span style="font-size: 11px; color: #858585;">Markdown Compatible</span>
            </div>

            <div class="adr-meta-grid" style="display: grid; grid-template-columns: 120px 1fr 140px; gap: 12px;">
                <div class="form-group">
                    <label>ID</label>
                    <input type="text" id="adrId" class="adr-input" value="ADR-001" oninput="updateLivePreview()">
                </div>
                <div class="form-group">
                    <label>Title</label>
                    <input type="text" id="adrTitle" class="adr-input" value="Use PostgreSQL JSONB for Domain Audit Events" oninput="updateLivePreview()">
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select id="adrStatus" class="adr-select" onchange="updateLivePreview()">
                        <option value="ACCEPTED" selected>ACCEPTED</option>
                        <option value="PROPOSED">PROPOSED</option>
                        <option value="SUPERSEDED">SUPERSEDED</option>
                        <option value="DEPRECATED">DEPRECATED</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>{{ icons.icon('terminal', 12) }} Context & Problem Statement</label>
                <textarea id="adrContext" class="adr-textarea" rows="4" oninput="updateLivePreview()">The platform requires an immutable append-only audit store for user progression, code evaluations, and certification attempts. The engineering team has strong expertise in PostgreSQL and Doctrine ORM. Introducing a separate document database (such as MongoDB) increases operational overhead, backup complexity, and transaction coordination risks.</textarea>
            </div>

            <div class="form-group">
                <label>{{ icons.icon('check', 12) }} Decision Outcome</label>
                <textarea id="adrDecision" class="adr-textarea" rows="3" oninput="updateLivePreview()">We will store immutable domain events in PostgreSQL using a dedicated `domain_events` table with a native `JSONB` column for payload data and a GIN index on event metadata.</textarea>
            </div>

            <div class="adr-consequences-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label style="color: #89d185;">{{ icons.icon('check-circle', 12) }} Positive Consequences</label>
                    <textarea id="adrPositives" class="adr-textarea" rows="3" oninput="updateLivePreview()">- Zero additional infrastructure components or cloud dependencies.
- ACID transactions across domain state changes and event publication using Doctrine Unit of Work.
- High query performance with PostgreSQL GIN indexing on JSONB payloads.</textarea>
                </div>
                <div class="form-group">
                    <label style="color: #f14c4c;">{{ icons.icon('alert-triangle', 12) }} Negative Consequences & Trade-offs</label>
                    <textarea id="adrNegatives" class="adr-textarea" rows="3" oninput="updateLivePreview()">- Table size will grow rapidly; requires monthly table partitioning strategy.
- Developers must enforce schema backward-compatibility in PHP serializers rather than relying on dynamic schemaless morphs.</textarea>
                </div>
            </div>

            <div class="form-group">
                <label>{{ icons.icon('shield', 12) }} Compliance & Verification Strategy</label>
                <textarea id="adrCompliance" class="adr-textarea" rows="2" oninput="updateLivePreview()">Static analysis via PHPStan rules verifying that domain event classes are readonly and implement `JsonSerializable`. Integration tests verifying GIN index usage via EXPLAIN ANALYZE in CI.</textarea>
            </div>
        </div>

        <!-- Right: Live Preview & Senior Rubric -->
        <div class="adr-preview-panel">
            <div class="rubric-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <span style="font-size: 12px; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 6px;">
                        {{ icons.icon('activity', 14) }} Architecture Review Rubric
                    </span>
                    <span id="overallScoreBadge" style="background: rgba(137, 209, 133, 0.2); color: #89d185; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700;">Score: 94 / 100</span>
                </div>
                <div class="metric-row">
                    <span style="color: #858585;">Context & Forces Clarity</span>
                    <span id="scoreContext" class="metric-score">95%</span>
                </div>
                <div class="metric-row">
                    <span style="color: #858585;">Trade-offs & Negatives Articulated</span>
                    <span id="scoreTradeoffs" class="metric-score">90%</span>
                </div>
                <div class="metric-row">
                    <span style="color: #858585;">Reversibility & Blast Radius Risk</span>
                    <span id="scoreReversibility" class="metric-score">Low Risk (88%)</span>
                </div>
                <div class="metric-row">
                    <span style="color: #858585;">Operational Simplicity</span>
                    <span id="scoreOps" class="metric-score">High (100%)</span>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #858585;">
                    Live Markdown Document
                </span>
                <span style="font-size: 11px; color: #6e7681; font-family: var(--font-mono);" id="docCharCount">
                    0 chars
                </span>
            </div>

            <div class="markdown-rendered" id="renderedMarkdown"></div>
        </div>
    </div>
</div>

<script>
const presets = {
    'adr-001': {
        id: 'ADR-001',
        title: 'Use PostgreSQL JSONB for Domain Audit Events',
        status: 'ACCEPTED',
        context: 'The platform requires an immutable append-only audit store for user progression, code evaluations, and certification attempts. The engineering team has strong expertise in PostgreSQL and Doctrine ORM. Introducing a separate document database (such as MongoDB) increases operational overhead, backup complexity, and transaction coordination risks.',
        decision: 'We will store immutable domain events in PostgreSQL using a dedicated `domain_events` table with a native `JSONB` column for payload data and a GIN index on event metadata.',
        positives: '- Zero additional infrastructure components or cloud dependencies.\n- ACID transactions across domain state changes and event publication using Doctrine Unit of Work.\n- High query performance with PostgreSQL GIN indexing on JSONB payloads.',
        negatives: '- Table size will grow rapidly; requires monthly table partitioning strategy.\n- Developers must enforce schema backward-compatibility in PHP serializers rather than relying on dynamic schemaless morphs.',
        compliance: 'Static analysis via PHPStan rules verifying that domain event classes are readonly and implement `JsonSerializable`. Integration tests verifying GIN index usage via EXPLAIN ANALYZE in CI.'
    },
    'adr-002': {
        id: 'ADR-002',
        title: 'Modular Monolith Architecture over Microservices',
        status: 'ACCEPTED',
        context: 'The academy currently serves interactive labs, code evaluation, and curriculum management with a single development team (1-5 engineers). While microservices offer decoupled deployments, they introduce distributed tracing overhead, network latency, eventual consistency failures, and dual-write complexity.',
        decision: 'We adopt a Modular Monolith architecture structured into bounded contexts (Learning, Evaluation, Billing, Identity) separated by PHP interfaces and internal Symfony event subscribers. Shared database with strict schema namespacing.',
        positives: '- Single deployment pipeline and trivial local development setup (DDEV / Docker Compose).\n- Direct in-process method calls with zero network serialization overhead.\n- Simple database transactions across boundaries when strictly required.',
        negatives: '- Build and CI test suite runtimes increase as codebase expands.\n- Requires strict linting rules (Deptrac / PHPStan) to prevent cross-boundary domain coupling.',
        compliance: 'Continuous integration executes Deptrac verifying that domain layers never import infrastructure or foreign modules directly.'
    },
    'adr-003': {
        id: 'ADR-003',
        title: 'Symfony Messenger with RabbitMQ for Asynchronous Tasks',
        status: 'ACCEPTED',
        context: 'Code evaluation and certification PDF generation can take between 2 to 15 seconds. Executing these synchronously in the PHP-FPM worker blocks HTTP response cycles and causes timeout cascades during peak traffic.',
        decision: 'Implement asynchronous message queues using Symfony Messenger component with RabbitMQ AMQP transport. Critical events use transactional outbox pattern to guarantee at-least-once delivery.',
        positives: '- Instant HTTP response (<50ms) to user submissions.\n- Worker auto-scaling decoupled from web HTTP tier.\n- Automatic retries with exponential backoff and dead-letter queues (DLQ) for failed jobs.',
        negatives: '- Requires RabbitMQ broker cluster maintenance and monitoring.\n- UI must handle asynchronous polling or SSE updates for evaluation status.',
        compliance: 'Healthcheck probes monitoring RabbitMQ queue lengths and consumer worker heartbeats in Prometheus/Grafana.'
    },
    'custom': {
        id: 'ADR-004',
        title: 'Architecture Decision Title Here',
        status: 'PROPOSED',
        context: 'Describe the context, technical forces, business drivers, and alternatives evaluated.',
        decision: 'State the chosen architectural approach clearly and concisely.',
        positives: '- Positive outcome 1\n- Positive outcome 2',
        negatives: '- Trade-off or downside 1\n- Operational cost 2',
        compliance: 'How will this decision be enforced or measured in CI/CD?'
    }
};

function loadPreset(key) {
    const data = presets[key];
    if (!data) return;

    document.getElementById('adrId').value = data.id;
    document.getElementById('adrTitle').value = data.title;
    document.getElementById('adrStatus').value = data.status;
    document.getElementById('adrContext').value = data.context;
    document.getElementById('adrDecision').value = data.decision;
    document.getElementById('adrPositives').value = data.positives;
    document.getElementById('adrNegatives').value = data.negatives;
    document.getElementById('adrCompliance').value = data.compliance;

    updateLivePreview();
}

function updateLivePreview() {
    const id = document.getElementById('adrId').value;
    const title = document.getElementById('adrTitle').value;
    const status = document.getElementById('adrStatus').value;
    const context = document.getElementById('adrContext').value;
    const decision = document.getElementById('adrDecision').value;
    const positives = document.getElementById('adrPositives').value;
    const negatives = document.getElementById('adrNegatives').value;
    const compliance = document.getElementById('adrCompliance').value;

    const statusTag = document.getElementById('adrStatusTag');
    statusTag.textContent = status;
    statusTag.className = status === 'ACCEPTED' ? 'status-badge-accepted' : (status === 'PROPOSED' ? 'status-badge-proposed' : 'status-badge-deprecated');

    const markdown = `# ${id}: ${title}

Date: ${new Date().toISOString().slice(0, 10)}
Status: ${status}

## Context and Problem Statement
${context}

## Decision Outcome
${decision}

### Positive Consequences
${positives}

### Negative Consequences & Trade-offs
${negatives}

## Compliance & Verification
${compliance}
`;

    document.getElementById('renderedMarkdown').textContent = markdown;
    document.getElementById('docCharCount').textContent = markdown.length + ' chars';

    // Rubric score calculation
    let score = 50;
    if (context.length > 80) score += 15;
    if (decision.length > 40) score += 15;
    if (positives.length > 30) score += 10;
    if (negatives.length > 30) score += 10;

    const overall = Math.min(score, 100);
    document.getElementById('overallScoreBadge').textContent = 'Score: ' + overall + ' / 100';
    document.getElementById('overallScoreBadge').style.color = overall >= 80 ? '#89d185' : '#dcdcaa';
}

function copyMarkdown() {
    const md = document.getElementById('renderedMarkdown').textContent;
    navigator.clipboard.writeText(md).then(() => {
        alert('ADR Markdown copied to clipboard.');
    });
}

function downloadAdr() {
    const id = document.getElementById('adrId').value.toLowerCase().replace(/[^a-z0-9_-]/g, '-');
    const md = document.getElementById('renderedMarkdown').textContent;
    const blob = new Blob([md], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${id}.md`;
    a.click();
    URL.revokeObjectURL(url);
}

// Initial render
updateLivePreview();
</script>
{% endblock %}
