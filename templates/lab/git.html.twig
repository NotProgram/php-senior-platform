            <ul style="color: var(--text-muted); line-height: 1.6; padding-left: 16px; margin: 0;">
                <li>Usa <strong>Trunk-Based Development</strong> para evitar ramas de larga duración (evita "Merge Hell").</li>
                <li>Usa <code>git commit --amend</code> o <code>git rebase -i</code> para pulir historial local antes del PR.</li>
                <li>Nunca hagas <code>git push --force</code> en ramas compartidas (<code>main</code>, <code>staging</code>).</li>
                <li>Escribe mensajes conformes a <strong>Conventional Commits</strong> (<code>feat:</code>, <code>fix:</code>, <code>refactor:</code>).</li>
            </ul>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    let stagedFiles = [];
    let workingFiles = ['PaymentService.php', 'OrderInvoice.php'];
    let activeBranch = 'main';

    function logTerminal(cmd, output) {
        const term = document.getElementById('terminal-output');
        const cmdLine = document.createElement('div');
        cmdLine.style.color = '#89d185';
        cmdLine.style.marginTop = '6px';
        cmdLine.textContent = '$ ' + cmd;
        term.appendChild(cmdLine);

        if (output) {
            const outLine = document.createElement('div');
            outLine.style.color = '#cccccc';
            outLine.textContent = output;
            term.appendChild(outLine);
        }
        term.scrollTop = term.scrollHeight;
    }

    function stageFile(filename) {
        if (!stagedFiles.includes(filename)) {
            stagedFiles.push(filename);
            workingFiles = workingFiles.filter(f => f !== filename);
            updateFileViews();
            logTerminal('git add ' + filename, 'Staged 1 file (' + filename + ')');
        }
    }

    function updateFileViews() {
        document.getElementById('count-working').textContent = workingFiles.length + ' archivos';
        document.getElementById('count-staged').textContent = stagedFiles.length + ' archivos';

        const stageList = document.getElementById('staging-area-list');
        stageList.innerHTML = '';
        if (stagedFiles.length === 0) {
            stageList.innerHTML = '<div style="color: var(--text-muted); font-size: 11.5px; text-align: center; margin-top: 40px;">(Ejecuta \'git add\' para pasar cambios al Index)</div>';
        } else {
            stagedFiles.forEach(file => {
                const card = document.createElement('div');
                card.className = 'git-file-card';
                card.innerHTML = '<div><div style="font-weight: 600;">' + file + '</div><span class="git-file-status status-staged">STAGED</span></div>' +
                    '<button type="button" class="btn-vs" style="padding: 2px 6px; font-size: 10px;" onclick="unstageFile(\'' + file + '\')">Unstage</button>';
                stageList.appendChild(card);
            });
        }

        const workList = document.getElementById('working-tree-list');
        workList.innerHTML = '';
        if (workingFiles.length === 0) {
            workList.innerHTML = '<div style="color: var(--accent-success); font-size: 11.5px; text-align: center; margin-top: 40px;">Working tree limpio. Nada pendiente.</div>';
        } else {
            workingFiles.forEach(file => {
                const card = document.createElement('div');
                card.className = 'git-file-card';
                card.innerHTML = '<div><div style="font-weight: 600;">' + file + '</div><span class="git-file-status status-modified">MODIFIED</span></div>' +
                    '<button type="button" class="btn-vs" style="padding: 3px 8px; font-size: 11px;" onclick="stageFile(\'' + file + '\')">Add</button>';
                workList.appendChild(card);
            });
        }
    }

    function unstageFile(filename) {
        stagedFiles = stagedFiles.filter(f => f !== filename);
        workingFiles.push(filename);
        updateFileViews();
        logTerminal('git restore --staged ' + filename, 'Unstaged ' + filename);
    }

    function runCommand(cmd) {
        if (cmd === 'git add .') {
            stagedFiles = [...stagedFiles, ...workingFiles];
            workingFiles = [];
            updateFileViews();
            logTerminal(cmd, 'All modified files staged in index.');
        } else if (cmd === 'git stash') {
            logTerminal(cmd, 'Saved working directory and index state WIP on main.');
        } else if (cmd === 'git stash pop') {
            logTerminal(cmd, 'Restored stashed changes into working tree.');
        } else if (cmd.startsWith('git switch -c')) {
            const branch = cmd.split(' ')[3] || 'feature/new';
            activeBranch = branch;
            document.getElementById('active-branch-label').textContent = branch;
            logTerminal(cmd, 'Switched to a new branch \'' + branch + '\'');
        } else if (cmd.startsWith('git rebase')) {
            logTerminal(cmd, 'First, rewinding head to replay your work on top of it... Fast-forwarded.');
        }
    }

    function runCommitPrompt() {
        if (stagedFiles.length === 0) {
            logTerminal('git commit', 'fatal: no changes added to commit (use "git add")');
            return;
        }
        const msg = prompt('Mensaje de commit (formato Conventional Commits):', 'feat(payment): integrate resilient charge handler');
        if (msg) {
            const hash = Math.random().toString(16).substring(2, 9);
            logTerminal('git commit -m "' + msg + '"', '[' + activeBranch + ' ' + hash + '] ' + msg + '\n ' + stagedFiles.length + ' files changed, 48 insertions(+)');
            
            // Add to graph
            const graph = document.getElementById('git-graph-history');
            const node = document.createElement('div');
            node.className = 'commit-node';
            node.innerHTML = '<span class="branch-badge branch-head">HEAD &rarr; ' + activeBranch + '</span>' +
                '<span class="commit-hash">' + hash + '</span>' +
                '<span style="color: #ffffff; font-weight: 600;">' + msg + '</span>' +
                '<span style="color: var(--text-muted); margin-left: auto;">ahora mismo</span>';
            graph.insertBefore(node, graph.firstChild);

            stagedFiles = [];
            updateFileViews();
        }
    }

    function simulatePush() {
        logTerminal('git push origin ' + activeBranch, 'Enumerating objects: 5, done.\nWriting objects: 100% (5/5), 1.2 KiB | done.\nTo github.com:company/symfony-senior-academy.git\n   a4d87b0..c8f91a2  ' + activeBranch + ' -> ' + activeBranch);
    }

    function executeCustomCommand() {
        const input = document.getElementById('custom-git-input');
        const cmd = input.value.trim();
        if (!cmd) return;
        input.value = '';

        if (cmd === 'git status') {
            logTerminal(cmd, 'On branch ' + activeBranch + '\nWorking tree status updated.');
        } else if (cmd === 'git log' || cmd === 'git log --oneline') {
            logTerminal(cmd, 'c8f91a2 (HEAD -> main) feat(checkout): add order state machine\na4d87b0 (origin/main) refactor(domain): extract immutable Money VO');
        } else if (cmd.startsWith('git add')) {
            runCommand('git add .');
        } else if (cmd.startsWith('git commit')) {
            runCommitPrompt();
        } else {
            logTerminal(cmd, 'Comando simulado ejecutado correctamente.');
        }
    }

    function validateConflictResolution() {
        const content = document.getElementById('conflict-textarea').value;
        const statusEl = document.getElementById('conflict-validation-status');

        const hasHead = content.includes('<<<<<<<');
        const hasDiv = content.includes('=======');
        const hasBranch = content.includes('>>>>>>>');

        if (hasHead || hasDiv || hasBranch) {
            statusEl.innerHTML = '<span style="color: var(--accent-red); font-weight: 700;">Error: Todavía existen marcadores de conflicto (&lt;&lt;&lt;&lt;&lt;&lt;&lt;, =======, &gt;&gt;&gt;&gt;&gt;&gt;&gt;) en el código.</span>';
        } else if (!content.includes('chargeOrder') || !content.includes('function')) {
            statusEl.innerHTML = '<span style="color: var(--accent-red); font-weight: 700;">Error: La firma de la función chargeOrder fue eliminada erróneamente.</span>';
        } else {
            statusEl.innerHTML = '<span style="color: var(--accent-success); font-weight: 700;">¡Conflicto resuelto con éxito! Se eliminaron los marcadores y se unificó la lógica. Generando merge commit...</span>';
            logTerminal('git commit -m "Merge branch \'feature/payments\'"', '[main f9b20e1] Merge branch \'feature/payments\' into main\nResolved conflict in PaymentService.php.');
        }
    }

    function resetGitLab() {
        workingFiles = ['PaymentService.php', 'OrderInvoice.php'];
        stagedFiles = [];
        activeBranch = 'main';
        document.getElementById('active-branch-label').textContent = 'main';
        updateFileViews();
        document.getElementById('conflict-textarea').value = `<<<<<<< HEAD\n    public function chargeOrder(Order $order): bool\n    {\n        // En main: cobro síncrono directo con timeout estricto de 3s\n        return $this->stripeGateway->charge($order->getTotal(), timeout: 3.0);\n    }\n=======\n    public function chargeOrder(Order $order): bool\n    {\n        // En feature/payments: pasarela resiliente con fallback a PayPal\n        return $this->resilientGateway->chargeWithFallback($order->getId(), $order->getTotal());\n    }\n>>>>>>> feature/payments`;
        document.getElementById('conflict-validation-status').innerHTML = 'Estado: Conflicto reiniciado';
        logTerminal('git reset --hard HEAD', 'HEAD is now at c8f91a2 feat(checkout): add order state machine');
    }
</script>
{% endblock %}
