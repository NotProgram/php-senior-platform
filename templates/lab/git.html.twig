                <!-- Custom Command Input -->
                <div style="display: flex; gap: 6px; margin-top: 6px;">
                    <input type="text" id="custom-git-input" placeholder="Escribe un comando git..." style="flex: 1; background: #141414; border: 1px solid var(--border-main); border-radius: 4px; padding: 6px 10px; font-size: 12px; color: #ffffff; font-family: var(--font-mono);" onkeydown="if (event.key === 'Enter') executeCustomCommand()">
