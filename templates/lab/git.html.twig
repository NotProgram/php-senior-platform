                {{ icons.icon('alert-triangle', 15) }}
                <span>CONFLICT (content): Merge conflict in src/Service/PaymentService.php</span>
            </div>
            <div style="padding: 14px; background: #1a1a1a; font-size: 12.5px; border-bottom: 1px solid var(--border-main);">
                <p style="color: #cccccc; margin-bottom: 8px;">
