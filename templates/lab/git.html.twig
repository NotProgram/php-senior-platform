                <div style="font-size: 13px; font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 8px;">
                    {{ icons.icon('git-branch', 14) }}
                    <span>Visualizador del Grafo de Ramas (Git Log --graph)</span>
                </div>
                <div style="font-size: 11px; color: var(--text-muted);">
                    Ramas locales: <span class="branch-badge branch-main">main</span> <span class="branch-badge branch-feature">feature/payments</span>
                </div>
            </div>

            <div id="git-graph-history">
                <div class="commit-node">
                    <span class="branch-badge branch-head">HEAD &rarr; main</span>
                    <span class="commit-hash">c8f91a2</span>
                    <span style="color: #ffffff; font-weight: 600;">feat(checkout): add order state machine</span>
                    <span style="color: var(--text-muted); margin-left: auto;">hace 20 min por Dilan</span>
                </div>
                <div class="commit-node">
                    <span class="branch-badge branch-feature">feature/payments</span>
                    <span class="commit-hash">e31c509</span>
                    <span style="color: #ffffff; font-weight: 600;">feat(payment): integrate stripe webhook handler</span>
                    <span style="color: var(--text-muted); margin-left: auto;">hace 1 hora por Dilan</span>
                </div>
                <div class="commit-node">
                    <span class="branch-badge branch-main">origin/main</span>
                    <span class="commit-hash">a4d87b0</span>
                    <span style="color: #ffffff; font-weight: 600;">refactor(domain): extract immutable Money VO</span>
                    <span style="color: var(--text-muted); margin-left: auto;">hace 3 horas por Carlos</span>
