            </div>
        </div>

        <!-- Senior Best Practices Card -->
        <div style="background: #1e1e1e; border: 1px solid var(--border-main); border-radius: 6px; padding: 14px; font-size: 12px;">
            <div style="font-weight: 700; color: #ffffff; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                {{ icons.icon('award', 13) }}
                <span>Senior Git Rulebook</span>
