                <div style="color: #f14c4c; margin-left: 12px;">OrderInvoice.php</div>
            </div>

            <!-- Command Quick Actions -->
            <div style="padding: 12px; background: #1e1e1e; border-top: 1px solid var(--border-main); display: flex; flex-direction: column; gap: 8px;">
