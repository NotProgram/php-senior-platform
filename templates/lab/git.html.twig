{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Git & Conflict Simulator | Senior DevLab{% endblock %}

{% block stylesheets %}
<style>
    .git-workspace {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 16px;
        min-height: calc(100vh - 160px);
    }
    .git-main-column {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .git-flow-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 12px;
    }
    .git-column {
        background: #181818;
        border: 1px solid var(--border-main);
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .git-column-header {
        padding: 10px 14px;
        background: #252526;
        border-bottom: 1px solid var(--border-main);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .git-column-body {
        padding: 12px;
        min-height: 140px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }
    .git-file-card {
        background: #202020;
        border: 1px solid var(--border-main);
        border-radius: 4px;
        padding: 8px 10px;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.2s ease;
    }
    .git-file-card:hover {
        border-color: var(--accent-blue);
    }
    .git-file-status {
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: 700;
    }
    .status-modified { background: rgba(204, 167, 0, 0.2); color: #ffe066; }
    .status-staged { background: rgba(137, 209, 133, 0.2); color: #89d185; }
    .status-untracked { background: rgba(0, 122, 204, 0.2); color: #4fc1ff; }
    .status-conflict { background: rgba(241, 76, 76, 0.2); color: #f14c4c; }

    .graph-panel {
        background: #141414;
        border: 1px solid var(--border-main);
        border-radius: 6px;
        padding: 16px;
        position: relative;
    }
    .commit-node {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 12px;
        background: #1e1e1e;
        border: 1px solid var(--border-main);
        border-radius: 4px;
        margin-bottom: 8px;
        font-size: 12px;
    }
    .commit-hash {
        font-family: var(--font-mono);
        color: #ce9178;
        font-weight: 700;
    }
    .branch-badge {
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 10.5px;
        font-weight: 700;
    }
    .branch-main { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }
    .branch-feature { background: rgba(234, 179, 8, 0.2); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.4); }
    .branch-head { background: rgba(137, 209, 133, 0.2); color: #89d185; border: 1px solid rgba(137, 209, 133, 0.4); }

    .conflict-box {
        background: #181818;
        border: 1px solid var(--accent-red);
        border-radius: 6px;
        overflow: hidden;
    }
    .conflict-header {
        background: #2a1818;
        padding: 8px 14px;
        border-bottom: 1px solid var(--accent-red);
        font-size: 12px;
        font-weight: 700;
        color: var(--accent-red);
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .conflict-editor {
        width: 100%;
        background: #141414;
        color: #d4d4d4;
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.5;
        padding: 12px;
        border: none;
        outline: none;
        resize: vertical;
        min-height: 160px;
    }
</style>
{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span class="user-badge" style="background: rgba(240, 80, 50, 0.15); border-color: rgba(240, 80, 50, 0.4); color: #f05032;">
                {{ icons.icon('git', 14) }}
                <span>Simulador de Ingeniería Git</span>
            </span>
            <span class="user-badge" style="background: rgba(255, 255, 255, 0.05); border-color: var(--border-main); color: var(--text-muted);">
                Rama activa: <strong id="active-branch-label" style="color: #60a5fa; margin-left: 4px;">main</strong>
            </span>
        </div>
        <h1 class="page-title">
            {{ icons.icon('git-branch', 22) }}
            <span>Laboratorio Interactivo de Git & Resolución de Conflictos</span>
        </h1>
        <p class="page-subtitle">
            Experimenta el modelo mental de Git: transiciones entre Working Tree, Staging Area, Commits locales y Remote, más resolución guiada de conflictos reales.
        </p>
    </div>

    <div style="display: flex; gap: 8px;">
        <button type="button" class="btn-vs" onclick="resetGitLab()">
            {{ icons.icon('refresh-cw', 13) }}
            <span>Restablecer Estado</span>
        </button>
    </div>
</div>

<div class="git-workspace">
    <!-- Main Simulation Column -->
    <div class="git-main-column">
        
