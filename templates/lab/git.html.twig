            </div>

            <!-- 1.4 Remote (origin/main) -->
            <div class="git-column">
                <div class="git-column-header">
                    <span style="color: #ce9178;">Remote (origin)</span>
                    <span style="font-size: 10px; color: var(--text-muted);">Sincronizado</span>
                </div>
                <div class="git-column-body">
                    <div style="font-size: 11.5px; color: var(--text-muted); line-height: 1.6;">
