                        git commit -m
                    </button>
                    <button type="button" class="btn-vs" style="justify-content: center; font-size: 11px;" onclick="runCommand('git switch -c feature/auth')">
                        git switch -c
                    </button>
                    <button type="button" class="btn-vs" style="justify-content: center; font-size: 11px;" onclick="runCommand('git rebase main')">
                        git rebase main
                    </button>
                    <button type="button" class="btn-vs" style="justify-content: center; font-size: 11px;" onclick="runCommand('git stash')">
                        git stash
                    </button>
                    <button type="button" class="btn-vs" style="justify-content: center; font-size: 11px;" onclick="runCommand('git stash pop')">
                        git stash pop
                    </button>
