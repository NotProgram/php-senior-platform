{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}{{ module.title }} | Roadmap Senior{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">
        {{ icons.icon(module.icon|default('folder'), 24) }}
        <span>{{ module.title }}</span>
    </h1>
    <p class="page-subtitle">
        {{ module.description|default('M&oacute;dulo de especializaci&oacute;n y perfeccionamiento profesional.') }}
    </p>
</div>

<div style="display: flex; flex-direction: column; gap: 12px;">
    {% if module.lessons is defined %}
        {% for lesson in module.lessons %}
            <div class="metric-card" style="padding: 16px; display: flex; flex-direction: row; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 14px;">
                    {{ icons.icon('file-code', 20) }}
                    <div>
                        <h3 style="font-size: 14px; font-weight: 600; color: #ffffff;">{{ lesson.title }}</h3>
                        <span style="font-size: 11.5px; color: #858585;">Duraci&oacute;n: {{ lesson.minutes }} min &bull; Nivel: {{ lesson.difficulty }}</span>
                    </div>
                </div>
                <a href="{{ path('app_lesson', {lessonSlug: lesson.slug}) }}" class="btn-vs">
                    {{ icons.icon('play', 12) }}
                    <span>Abrir Lecci&oacute;n</span>
                </a>
            </div>
        {% endfor %}
    {% else %}
        <p style="color: #858585;">Este m&oacute;dulo est&aacute; en constante expansi&oacute;n.</p>
    {% endif %}
</div>
{% endblock %}
